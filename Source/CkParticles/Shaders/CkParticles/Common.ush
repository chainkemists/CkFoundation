// /CkParticles/Common.ush — shared CkParticles stage I/O + helpers.
#pragma once

// --------------------------------------------------------------------------------------------------------------------
// Per-particle inputs a behavior receives for one stage (typically Particle Update).
// --------------------------------------------------------------------------------------------------------------------
struct FCkParticles_StageInput
{
    int    BehaviorId;   // selects the behavior (see CkParticles_ExecuteStage)
    float  DeltaTime;    // seconds since last stage execution
    float  Age;          // particle age in seconds
    float  Lifetime;     // particle lifetime in seconds (0 if unset)
    float3 Position;     // current particle position (sim space)
    float3 Velocity;     // current particle velocity
    int    Seed;         // stable per-particle id (Particles.UniqueID) — hash for per-particle randomness
};

// --------------------------------------------------------------------------------------------------------------------
// Per-particle outputs a behavior writes. The caller assigns these back to particle attributes.
//
// Renderer selection (VisTag -> renderer visibility tags on the template):
//   0 = camera-facing sprite (default; per-effect texture via User.SpriteMaterial)
//   1 = velocity-aligned sprite (streaks/tracers; stretch = Size.y along motion)
//   2 = smoke sprite (translucent soft material; Rotation applies)
//   3 = mesh (MeshIndex picks the carrier: 0 Sweep, 1 Tube, 2 Shell, 3 Disc; Scale/Orientation apply)
//   4 = custom-facing sprite (a quad fixed in SIM space, not camera-facing; SpriteAlignment = its "up"
//       axis, SpriteFacing = its plane normal). For ground decals/range rings, whose source systems use
//       Niagara's CustomAlignment + CustomFacingVector pair. Material comes from User.SpriteMaterial.
//   5+ = ROW-DECLARED renderers. A cadence row may declare extra renderers of its own
//       (ck::particles::FCk_ParticlesRendererSpec), each with a named generated mesh and/or a named CkUsf
//       look bound explicitly. They exist only on that row's template, so a behavior writing one of these
//       tags renders nothing anywhere else. Behavior 7 (Slash) owns 5..9; behaviors 18 and 19 (the
//       projectile pair) share 10..11 on one cadence row; the Vefects hit/burst ports own 12..14 (20),
//       15..27 (21) and 28..36 (22).
//
// Dynamic -> Particles.DynamicMaterialParameter, read by the VFX master materials as
//   x = dissolve/erosion threshold [0..1], y = distortion strength, z = UV pan offset, w = emissive boost.
//
// SubImageIndex -> Particles.SubImageIndex, the flipbook frame a renderer whose cadence row declared a
// SubImageSize grid draws. Frames run 0 .. (X*Y - 1) across the sheet, row-major. A renderer with no declared
// grid divides nothing and ignores the attribute, so a behavior that never writes it renders as before.
// --------------------------------------------------------------------------------------------------------------------
struct FCkParticles_StageOutput
{
    float3 Position;
    float3 Velocity;
    float4 Color;
    float2 Size;        // sprite size (x,y in sim units) -> Particles.SpriteSize. x==y is round; x!=y stretches.
    float3 Scale;       // mesh scale -> Particles.Scale (VisTag 3 only)
    float4 Orientation; // mesh orientation quat (x,y,z,w) -> Particles.MeshOrientation (VisTag 3 only)
    float4 Dynamic;     // material dynamic params -> Particles.DynamicMaterialParameter (see header comment)
    float  Rotation;    // sprite rotation in DEGREES -> Particles.SpriteRotation
    int    MeshIndex;   // carrier mesh index -> Particles.MeshIndex (VisTag 3 only)
    int    VisTag;      // renderer selection -> Particles.VisibilityTag (see header comment)
    float3 SpriteAlignment; // -> Particles.SpriteAlignment, the sprite's "up" axis (VisTag 4 only)
    float3 SpriteFacing;    // -> Particles.SpriteFacing, the sprite's plane normal   (VisTag 4 only)
    float  SubImageIndex;   // -> Particles.SubImageIndex, the flipbook frame; see the header comment
};

// 0..1 over the particle's lifetime (0 when lifetime is unset).
float CkParticles_NormalizedAge(FCkParticles_StageInput In)
{
    return In.Lifetime > 0.0 ? saturate(In.Age / In.Lifetime) : 0.0;
}

// --------------------------------------------------------------------------------------------------------------------
// Per-particle randomness. CkParticles_Rand hashes (Seed, Salt) -> [0,1). Uses only the low 24 bits so float(n)/2^24
// is exact, giving bit-identical results between this GPU code and its C++ CPU mirror (NDICkParticlesLocal::Rand).
// Vary Salt to draw multiple independent randoms from one particle's Seed.
// --------------------------------------------------------------------------------------------------------------------
float CkParticles_Rand(int Seed, int Salt)
{
    uint n = uint(Seed) * 747796405u + uint(Salt) * 2891336453u + 1u;
    n ^= n >> 16;
    n *= 2246822519u;
    n ^= n >> 13;
    n *= 3266489917u;
    n ^= n >> 16;
    return float(n & 0x00FFFFFFu) / 16777216.0; // 24-bit -> [0,1), float-exact
}

// Uniformly distributed unit vector on the sphere, deterministic per Seed.
float3 CkParticles_RandDir(int Seed)
{
    const float z = 2.0 * CkParticles_Rand(Seed, 1) - 1.0; // [-1,1]
    const float t = 6.28318530718 * CkParticles_Rand(Seed, 2);
    const float r = sqrt(saturate(1.0 - z * z));
    return float3(r * cos(t), r * sin(t), z);
}

// --------------------------------------------------------------------------------------------------------------------
// Source-curve transcription.
//
// Every marketplace curve key the cookbook transcribes is a clamped or linear key, so a clamped lerp between
// neighbouring keys IS the curve: it holds the first key's value before it and the last key's after it, which is
// what Niagara does with a curve whose first key sits at t > 0. CkParticles_KeyN takes N (time, value) pairs in
// ascending time.
//
// CkParticles_IntN integrates the SAME piecewise-linear curve over [0, S] — velocity-scale curves need their exact
// integral, because a stepwise integration would tie position to frame cadence and drift against the CPU mirror.
// --------------------------------------------------------------------------------------------------------------------
float CkParticles_Key2(float T, float T0, float V0, float T1, float V1)
{
    return lerp(V0, V1, saturate((T - T0) / max(T1 - T0, 1e-6)));
}

float CkParticles_Key3(float T, float T0, float V0, float T1, float V1, float T2, float V2)
{
    return T <= T1 ? CkParticles_Key2(T, T0, V0, T1, V1)
                   : CkParticles_Key2(T, T1, V1, T2, V2);
}

float CkParticles_Key4(float T, float T0, float V0, float T1, float V1, float T2, float V2, float T3, float V3)
{
    return T <= T1 ? CkParticles_Key2(T, T0, V0, T1, V1)
                   : CkParticles_Key3(T, T1, V1, T2, V2, T3, V3);
}

float CkParticles_Key5(float T, float T0, float V0, float T1, float V1, float T2, float V2, float T3, float V3,
                       float T4, float V4)
{
    return T <= T1 ? CkParticles_Key2(T, T0, V0, T1, V1)
                   : CkParticles_Key4(T, T1, V1, T2, V2, T3, V3, T4, V4);
}

// Integral over [0, S] of the 2-key curve (0, V0) -> (1, V1), in units of normalized life.
float CkParticles_Int2(float S, float V0, float V1)
{
    const float A = saturate(S);
    return A * (V0 + CkParticles_Key2(A, 0.0, V0, 1.0, V1)) * 0.5;
}

// Integral over [0, S] of the 3-key curve (0, V0) -> (K, V1) -> (1, V2).
float CkParticles_Int3(float S, float K, float V0, float V1, float V2)
{
    const float T = saturate(S);
    const float A = min(T, K);
    float Sum = A * (V0 + CkParticles_Key2(A, 0.0, V0, K, V1)) * 0.5;

    if (T > K)
    {
        const float B = T - K;
        Sum += B * (V1 + CkParticles_Key2(T, K, V1, 1.0, V2)) * 0.5;
    }
    return Sum;
}

// Quaternion from a (normalized) axis and an angle in radians. Written out component-wise so the C++ CPU mirror
// (NDICkParticlesLocal::QuatFromAxisAngle) stays bit-identical — do not swap in engine quat helpers on either side.
float4 CkParticles_QuatFromAxisAngle(float3 Axis, float Angle)
{
    const float H = 0.5 * Angle;
    const float S = sin(H);
    return float4(Axis.x * S, Axis.y * S, Axis.z * S, cos(H));
}

// Hamilton product A*B: rotate by B first, then by A. Component-wise for CPU-mirror lockstep.
float4 CkParticles_QuatMul(float4 A, float4 B)
{
    return float4(
        A.w * B.x + A.x * B.w + A.y * B.z - A.z * B.y,
        A.w * B.y - A.x * B.z + A.y * B.w + A.z * B.x,
        A.w * B.z + A.x * B.y - A.y * B.x + A.z * B.w,
        A.w * B.w - A.x * B.x - A.y * B.y - A.z * B.z);
}

// Quaternion rotating the mesh's local +Z onto Dir (assumed unit). The carrier meshes the Vefects ports use are
// built along +Z, and a row-declared mesh renderer draws with Facing Default — so a source emitter whose renderer
// faces VELOCITY is reproduced by handing this its own velocity direction.
// Anti-parallel is the degenerate case: cross() vanishes there, so it takes an explicit half-turn about +X.
float4 CkParticles_QuatFromZTo(float3 Dir)
{
    const float3 Up = float3(0.0, 0.0, 1.0);
    const float  D  = clamp(dot(Up, Dir), -1.0, 1.0);

    if (D < -0.999999)
    { return float4(1.0, 0.0, 0.0, 0.0); }

    const float3 Axis = cross(Up, Dir);
    const float  Len  = length(Axis);

    if (Len < 1e-6)
    { return float4(0.0, 0.0, 0.0, 1.0); }

    return CkParticles_QuatFromAxisAngle(Axis / Len, acos(D));
}

// Pass-through defaults (a behavior overrides only what it changes). Size defaults to a per-Seed-varied value that
// shrinks over life, so even behaviors that never touch Size get non-uniform, animated sprites (salt 7 is reserved
// for size so it stays independent of a behavior's direction/hue randoms). New-contract fields default to the
// camera-sprite renderer with inert material dynamics, so legacy behaviors render exactly as before.
FCkParticles_StageOutput CkParticles_DefaultOutput(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O;
    O.Position = In.Position;
    O.Velocity = In.Velocity;
    O.Color    = float4(1.0, 1.0, 1.0, 1.0);
    const float SizeBase = lerp(18.0, 8.0, CkParticles_NormalizedAge(In)) * lerp(0.65, 1.35, CkParticles_Rand(In.Seed, 7));
    O.Size        = float2(SizeBase, SizeBase);
    O.Scale       = float3(1.0, 1.0, 1.0);
    O.Orientation = float4(0.0, 0.0, 0.0, 1.0);
    O.Dynamic     = float4(0.0, 0.0, 0.0, 0.0);
    O.Rotation    = 0.0;
    O.MeshIndex   = 0;
    O.VisTag      = 0;
    // Sim-space Z-up quad. Only VisTag 4 reads these, but they must never be zero: a degenerate
    // alignment/facing pair collapses the sprite instead of failing visibly.
    O.SpriteAlignment = float3(0.0, 1.0, 0.0);
    O.SpriteFacing    = float3(0.0, 0.0, 1.0);
    O.SubImageIndex   = 0.0;
    return O;
}
