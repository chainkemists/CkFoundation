// /CkParticles/Common.ush — shared CkParticles stage I/O + helpers.
#pragma once

// --------------------------------------------------------------------------------------------------------------------
// Per-particle inputs a behavior receives for one stage (typically Particle Update).
// --------------------------------------------------------------------------------------------------------------------
struct FCkParticles_StageInput
{
    int    BehaviorId;   // selects the behavior (see CkParticles_ExecuteStage)
    float  DeltaTime;    // seconds since last stage execution
    float  Age;          // particle age in seconds
    float  Lifetime;     // particle lifetime in seconds (0 if unset)
    float3 Position;     // current particle position (sim space)
    float3 Velocity;     // current particle velocity
    int    Seed;         // stable per-particle id (Particles.UniqueID) — hash for per-particle randomness
    // Emitter.Age — the emitter's own clock, which keeps running while individual particles are born and die.
    // Age is measured on the particle; this is measured on the emitter, so their difference is the moment in the
    // loop the particle spawned: SpawnPhase = fmod(EmitterAge - Age, LoopDuration). Burst particles land at
    // phase ~0, rate particles spread across the loop, and a windowed sub-layer gates on it.
    float  EmitterAge;
};

// --------------------------------------------------------------------------------------------------------------------
// Per-particle outputs a behavior writes. The caller assigns these back to particle attributes.
//
// Renderer selection (VisTag -> renderer visibility tags on the template):
//   0 = camera-facing sprite (default; per-effect texture via User.SpriteMaterial)
//   1 = velocity-aligned sprite (streaks/tracers; stretch = Size.y along motion)
//   2 = smoke sprite (translucent soft material; Rotation applies)
//   3 = mesh (MeshIndex picks the carrier: 0 Sweep, 1 Tube, 2 Shell, 3 Disc; Scale/Orientation apply)
//   4 = custom-facing sprite (a quad fixed in SIM space, not camera-facing; SpriteAlignment = its "up"
//       axis, SpriteFacing = its plane normal). For ground decals/range rings, whose source systems use
//       Niagara's CustomAlignment + CustomFacingVector pair. Material comes from User.SpriteMaterial.
//   5+ = ROW-DECLARED renderers. A cadence row may declare extra renderers of its own
//       (ck::particles::FCk_ParticlesRendererSpec), each with a named generated mesh and/or a named CkUsf
//       look bound explicitly. They exist only on that row's template, so a behavior writing one of these
//       tags renders nothing anywhere else. Behavior 7 (Slash) owns 5..9; behaviors 18 and 19 (the
//       projectile pair) share 10..11 on one cadence row; every Vefects port from 20 up allocates its own
//       contiguous band above those. The roster ceiling is DERIVED from the cadence table
//       (ck::particles::Get_RosterVisTag_Max) — never restate it here or anywhere else.
//
// Dynamic -> Particles.DynamicMaterialParameter, read by the VFX master materials as
//   x = dissolve/erosion threshold [0..1], y = distortion strength, z = UV pan offset, w = emissive boost.
//
// SubImageIndex -> Particles.SubImageIndex, the flipbook frame a renderer whose cadence row declared a
// SubImageSize grid draws. Frames run 0 .. (X*Y - 1) across the sheet, row-major. A renderer with no declared
// grid divides nothing and ignores the attribute, so a behavior that never writes it renders as before.
// --------------------------------------------------------------------------------------------------------------------
struct FCkParticles_StageOutput
{
    float3 Position;
    float3 Velocity;
    float4 Color;
    float2 Size;        // sprite size (x,y in sim units) -> Particles.SpriteSize. x==y is round; x!=y stretches.
    float3 Scale;       // mesh scale -> Particles.Scale (VisTag 3 only)
    float4 Orientation; // mesh orientation quat (x,y,z,w) -> Particles.MeshOrientation (VisTag 3 only)
    float4 Dynamic;     // material dynamic params -> Particles.DynamicMaterialParameter (see header comment)
    float  Rotation;    // sprite rotation in DEGREES -> Particles.SpriteRotation
    int    MeshIndex;   // carrier mesh index -> Particles.MeshIndex (VisTag 3 only)
    int    VisTag;      // renderer selection -> Particles.VisibilityTag (see header comment)
    float3 SpriteAlignment; // -> Particles.SpriteAlignment, the sprite's "up" axis (VisTag 4 only)
    float3 SpriteFacing;    // -> Particles.SpriteFacing, the sprite's plane normal   (VisTag 4 only)
    float  SubImageIndex;   // -> Particles.SubImageIndex, the flipbook frame; see the header comment
};

// 0..1 over the particle's lifetime (0 when lifetime is unset).
float CkParticles_NormalizedAge(FCkParticles_StageInput In)
{
    return In.Lifetime > 0.0 ? saturate(In.Age / In.Lifetime) : 0.0;
}

// --------------------------------------------------------------------------------------------------------------------
// Per-particle randomness. CkParticles_Rand hashes (Seed, Salt) -> [0,1). Uses only the low 24 bits so float(n)/2^24
// is exact, giving bit-identical results between this GPU code and its C++ CPU mirror (NDICkParticlesLocal::Rand).
// Vary Salt to draw multiple independent randoms from one particle's Seed.
// --------------------------------------------------------------------------------------------------------------------
float CkParticles_Rand(int Seed, int Salt)
{
    uint n = uint(Seed) * 747796405u + uint(Salt) * 2891336453u + 1u;
    n ^= n >> 16;
    n *= 2246822519u;
    n ^= n >> 13;
    n *= 3266489917u;
    n ^= n >> 16;
    return float(n & 0x00FFFFFFu) / 16777216.0; // 24-bit -> [0,1), float-exact
}

// Uniformly distributed unit vector on the sphere, deterministic per Seed.
float3 CkParticles_RandDir(int Seed)
{
    const float z = 2.0 * CkParticles_Rand(Seed, 1) - 1.0; // [-1,1]
    const float t = 6.28318530718 * CkParticles_Rand(Seed, 2);
    const float r = sqrt(saturate(1.0 - z * z));
    return float3(r * cos(t), r * sin(t), z);
}

// --------------------------------------------------------------------------------------------------------------------
// A point inside Niagara's Cylinder Location volume — the spawn shape every "Loop" source in the cookbook uses.
//
// Random distribution, Surface Only false, Height Midpoint 0.5: uniform through the volume, which means the radius
// takes a SQUARE root (a linear draw would pile every particle at the axis). Salt 9 is the angle, 7 the radial draw
// and 10 the height, chosen so a layer that also calls CkParticles_RandDir (salts 1-2) or sizes itself (salt 8)
// keeps its draws independent.
// --------------------------------------------------------------------------------------------------------------------
float3 CkParticles_CylinderPoint(int Seed, float Radius, float Height, float3 Offset)
{
    const float Angle = CkParticles_Rand(Seed, 9) * 6.28318530718;
    const float R     = Radius * sqrt(CkParticles_Rand(Seed, 7));
    const float Z     = (CkParticles_Rand(Seed, 10) - 0.5) * Height;

    return float3(R * cos(Angle), R * sin(Angle), Z) + Offset;
}

// --------------------------------------------------------------------------------------------------------------------
// HSV -> RGB, for the source's "Random Hue/Saturation/Value" colour mode.
//
// Niagara's Initialize Particle offers a colour mode that takes the emitter's authored base colour into HSV, shifts
// the hue by a random amount inside a range, and replaces saturation/value from their own ranges. The base colour is
// a per-emitter CONSTANT, so a behavior states its base HUE as a measured constant and only the inverse conversion is
// needed here. Written out branch-by-branch rather than via a saturate/frac trick so the C++ mirror is the same six
// lines and cannot round differently.
//
// H wraps (the hue circle has no ends); S and V are taken as given — a behavior that draws them from a source range
// has already clamped them by construction.
// --------------------------------------------------------------------------------------------------------------------
float3 CkParticles_HsvToRgb(float H, float S, float V)
{
    const float Hue = frac(H) * 6.0;
    const float Sector = floor(Hue);
    const float F = Hue - Sector;

    const float P = V * (1.0 - S);
    const float Q = V * (1.0 - S * F);
    const float T = V * (1.0 - S * (1.0 - F));

    if (Sector < 1.0) { return float3(V, T, P); }
    if (Sector < 2.0) { return float3(Q, V, P); }
    if (Sector < 3.0) { return float3(P, V, T); }
    if (Sector < 4.0) { return float3(P, Q, V); }
    if (Sector < 5.0) { return float3(T, P, V); }
    return float3(V, P, Q);
}

// --------------------------------------------------------------------------------------------------------------------
// Spawn phase — where in the emitter's loop a particle was born.
//
// A cadence row may carry a burst AND a rate, which is how a source that bursts N at loop start and then streams
// R/s is expressed. The two populations are told apart by WHEN they spawned: the burst module fires at Spawn Time
// 0, so its particles land at phase 0, and the rate stack spreads its particles across the whole loop.
//
// The epsilon is a float-precision floor, not a tuning: EmitterAge grows without bound while Age stays small, so
// their difference loses absolute precision as the system runs, and a burst particle's phase drifts off zero by
// roughly EmitterAge * 2^-24. 1 ms holds that classification correct past two hours of continuous play. A rate
// particle that happens to spawn inside the same millisecond is misread as a burst particle; at the rates the
// cookbook's sources use that is a few hundredths of a particle per loop.
// --------------------------------------------------------------------------------------------------------------------
float CkParticles_SpawnPhase(float EmitterAge, float Age, float LoopDuration)
{
    const float P = fmod(EmitterAge - Age, LoopDuration);
    return P < 0.0 ? P + LoopDuration : P;
}

bool CkParticles_IsBurstSpawn(float SpawnPhase, float LoopDuration)
{
    const float Eps = 0.001;
    return SpawnPhase < Eps || SpawnPhase > LoopDuration - Eps;
}

// --------------------------------------------------------------------------------------------------------------------
// Deterministic curl noise.
//
// The field is this plugin's tileable value-noise Fbm lifted to 3D: CkParticles_Rand's avalanche over an integer
// lattice cell (so the 24-bit normalization keeps it float-exact against the C++ mirror), smoothstep-interpolated,
// summed over octaves that halve amplitude, double frequency and double the wrap period — the same schedule the
// texture generator's 2D Fbm uses. Lattice coordinates wrap, so the field tiles.
//
// Curl is taken by CENTRAL FINITE DIFFERENCE at a fixed eps. Analytic gradients would have to be derived a second
// time for the CPU mirror and would drift apart the first time either side is edited; a difference quotient is the
// same three lines on both.
//
// Curl-driven motion stays STATELESS: CkParticles_CurlPath re-integrates the whole path from the spawn position on
// every evaluation with a FIXED step count, so a particle's position is a function of (spawn, Age, Seed) alone and
// never of the frame cadence that led there. The step count is a fidelity constant, not a tunable — changing it
// moves every curl-driven effect.
// --------------------------------------------------------------------------------------------------------------------
float CkParticles_NoiseHash3(int3 Cell, uint Salt)
{
    uint n = uint(Cell.x) * 747796405u + uint(Cell.y) * 2654435761u + uint(Cell.z) * 805459861u
           + Salt * 2891336453u + 1u;
    n ^= n >> 16;
    n *= 2246822519u;
    n ^= n >> 13;
    n *= 3266489917u;
    n ^= n >> 16;
    return float(n & 0x00FFFFFFu) / 16777216.0; // 24-bit -> [0,1), float-exact
}

int CkParticles_NoiseWrap(int V, int Period)
{
    return ((V % Period) + Period) % Period;
}

float CkParticles_ValueNoise3(float3 P, int Period, uint Salt)
{
    const int3   Ci = int3(floor(P));
    const float3 Cf = P - float3(Ci);
    const float3 W  = Cf * Cf * (3.0 - 2.0 * Cf);

    const int X0 = CkParticles_NoiseWrap(Ci.x,     Period);
    const int Y0 = CkParticles_NoiseWrap(Ci.y,     Period);
    const int Z0 = CkParticles_NoiseWrap(Ci.z,     Period);
    const int X1 = CkParticles_NoiseWrap(Ci.x + 1, Period);
    const int Y1 = CkParticles_NoiseWrap(Ci.y + 1, Period);
    const int Z1 = CkParticles_NoiseWrap(Ci.z + 1, Period);

    const float N000 = CkParticles_NoiseHash3(int3(X0, Y0, Z0), Salt);
    const float N100 = CkParticles_NoiseHash3(int3(X1, Y0, Z0), Salt);
    const float N010 = CkParticles_NoiseHash3(int3(X0, Y1, Z0), Salt);
    const float N110 = CkParticles_NoiseHash3(int3(X1, Y1, Z0), Salt);
    const float N001 = CkParticles_NoiseHash3(int3(X0, Y0, Z1), Salt);
    const float N101 = CkParticles_NoiseHash3(int3(X1, Y0, Z1), Salt);
    const float N011 = CkParticles_NoiseHash3(int3(X0, Y1, Z1), Salt);
    const float N111 = CkParticles_NoiseHash3(int3(X1, Y1, Z1), Salt);

    const float Near = lerp(lerp(N000, N100, W.x), lerp(N010, N110, W.x), W.y);
    const float Far  = lerp(lerp(N001, N101, W.x), lerp(N011, N111, W.x), W.y);
    return lerp(Near, Far, W.z);
}

// Three octaves over a base wrap period of 16 lattice cells.
float CkParticles_NoiseFbm3(float3 P, uint Salt)
{
    float Sum = 0.0, Amp = 0.5, Freq = 1.0, Norm = 0.0;
    int   Period = 16;

    for (int i = 0; i < 3; ++i)
    {
        Sum  += Amp * CkParticles_ValueNoise3(P * Freq, Period, Salt);
        Norm += Amp;
        Amp  *= 0.5;
        Freq *= 2.0;
        Period *= 2;
    }
    return Sum / Norm;
}

// Curl of the vector potential (Fbm(Seed), Fbm(Seed+1), Fbm(Seed+2)) sampled at P * Freq. Divergence-free by
// construction, which is what makes curl noise read as swirling flow rather than as jitter.
float3 CkParticles_CurlNoise(float3 P, float Freq, uint Seed)
{
    const float3 Q = P * Freq;
    const float  E = 0.01;

    const float3 Dx = float3(E, 0.0, 0.0);
    const float3 Dy = float3(0.0, E, 0.0);
    const float3 Dz = float3(0.0, 0.0, E);

    const float PsiX_Yp = CkParticles_NoiseFbm3(Q + Dy, Seed);
    const float PsiX_Yn = CkParticles_NoiseFbm3(Q - Dy, Seed);
    const float PsiX_Zp = CkParticles_NoiseFbm3(Q + Dz, Seed);
    const float PsiX_Zn = CkParticles_NoiseFbm3(Q - Dz, Seed);

    const float PsiY_Xp = CkParticles_NoiseFbm3(Q + Dx, Seed + 1u);
    const float PsiY_Xn = CkParticles_NoiseFbm3(Q - Dx, Seed + 1u);
    const float PsiY_Zp = CkParticles_NoiseFbm3(Q + Dz, Seed + 1u);
    const float PsiY_Zn = CkParticles_NoiseFbm3(Q - Dz, Seed + 1u);

    const float PsiZ_Xp = CkParticles_NoiseFbm3(Q + Dx, Seed + 2u);
    const float PsiZ_Xn = CkParticles_NoiseFbm3(Q - Dx, Seed + 2u);
    const float PsiZ_Yp = CkParticles_NoiseFbm3(Q + Dy, Seed + 2u);
    const float PsiZ_Yn = CkParticles_NoiseFbm3(Q - Dy, Seed + 2u);

    const float Inv = 1.0 / (2.0 * E);
    return float3(
        ((PsiZ_Yp - PsiZ_Yn) - (PsiY_Zp - PsiY_Zn)) * Inv,
        ((PsiX_Zp - PsiX_Zn) - (PsiZ_Xp - PsiZ_Xn)) * Inv,
        ((PsiY_Xp - PsiY_Xn) - (PsiX_Yp - PsiX_Yn)) * Inv);
}

// Position after advecting from SpawnPosition through the curl field over [0, Age] in 16 equal Euler steps.
float3 CkParticles_CurlPath(float3 SpawnPosition, float Age, float Freq, float Strength, uint Seed)
{
    const float Dt = Age / 16.0;

    // [loop], not unrolled: each step is twelve Fbm evaluations, and sixteen inlined copies of that is a shader
    // the compiler chews on for minutes and then spills registers over.
    float3 P = SpawnPosition;
    [loop]
    for (int i = 0; i < 16; ++i)
    { P += CkParticles_CurlNoise(P, Freq, Seed) * Strength * Dt; }
    return P;
}

// --------------------------------------------------------------------------------------------------------------------
// Source-curve transcription.
//
// Every marketplace curve key the cookbook transcribes is a clamped or linear key, so a clamped lerp between
// neighbouring keys IS the curve: it holds the first key's value before it and the last key's after it, which is
// what Niagara does with a curve whose first key sits at t > 0. CkParticles_KeyN takes N (time, value) pairs in
// ascending time.
//
// CkParticles_IntN integrates the SAME piecewise-linear curve over [0, S] — velocity-scale curves need their exact
// integral, because a stepwise integration would tie position to frame cadence and drift against the CPU mirror.
// --------------------------------------------------------------------------------------------------------------------
float CkParticles_Key2(float T, float T0, float V0, float T1, float V1)
{
    return lerp(V0, V1, saturate((T - T0) / max(T1 - T0, 1e-6)));
}

float CkParticles_Key3(float T, float T0, float V0, float T1, float V1, float T2, float V2)
{
    return T <= T1 ? CkParticles_Key2(T, T0, V0, T1, V1)
                   : CkParticles_Key2(T, T1, V1, T2, V2);
}

float CkParticles_Key4(float T, float T0, float V0, float T1, float V1, float T2, float V2, float T3, float V3)
{
    return T <= T1 ? CkParticles_Key2(T, T0, V0, T1, V1)
                   : CkParticles_Key3(T, T1, V1, T2, V2, T3, V3);
}

float CkParticles_Key5(float T, float T0, float V0, float T1, float V1, float T2, float V2, float T3, float V3,
                       float T4, float V4)
{
    return T <= T1 ? CkParticles_Key2(T, T0, V0, T1, V1)
                   : CkParticles_Key4(T, T1, V1, T2, V2, T3, V3, T4, V4);
}

// Integral over [0, S] of the 2-key curve (0, V0) -> (1, V1), in units of normalized life.
float CkParticles_Int2(float S, float V0, float V1)
{
    const float A = saturate(S);
    return A * (V0 + CkParticles_Key2(A, 0.0, V0, 1.0, V1)) * 0.5;
}

// Integral over [0, S] of the 3-key curve (0, V0) -> (K, V1) -> (1, V2).
float CkParticles_Int3(float S, float K, float V0, float V1, float V2)
{
    const float T = saturate(S);
    const float A = min(T, K);
    float Sum = A * (V0 + CkParticles_Key2(A, 0.0, V0, K, V1)) * 0.5;

    if (T > K)
    {
        const float B = T - K;
        Sum += B * (V1 + CkParticles_Key2(T, K, V1, 1.0, V2)) * 0.5;
    }
    return Sum;
}

// Quaternion from a (normalized) axis and an angle in radians. Written out component-wise so the C++ CPU mirror
// (NDICkParticlesLocal::QuatFromAxisAngle) stays bit-identical — do not swap in engine quat helpers on either side.
float4 CkParticles_QuatFromAxisAngle(float3 Axis, float Angle)
{
    const float H = 0.5 * Angle;
    const float S = sin(H);
    return float4(Axis.x * S, Axis.y * S, Axis.z * S, cos(H));
}

// Hamilton product A*B: rotate by B first, then by A. Component-wise for CPU-mirror lockstep.
float4 CkParticles_QuatMul(float4 A, float4 B)
{
    return float4(
        A.w * B.x + A.x * B.w + A.y * B.z - A.z * B.y,
        A.w * B.y - A.x * B.z + A.y * B.w + A.z * B.x,
        A.w * B.z + A.x * B.y - A.y * B.x + A.z * B.w,
        A.w * B.w - A.x * B.x - A.y * B.y - A.z * B.z);
}

// Quaternion rotating the mesh's local +Z onto Dir (assumed unit). The carrier meshes the Vefects ports use are
// built along +Z, and a row-declared mesh renderer draws with Facing Default — so a source emitter whose renderer
// faces VELOCITY is reproduced by handing this its own velocity direction.
// Anti-parallel is the degenerate case: cross() vanishes there, so it takes an explicit half-turn about +X.
float4 CkParticles_QuatFromZTo(float3 Dir)
{
    const float3 Up = float3(0.0, 0.0, 1.0);
    const float  D  = clamp(dot(Up, Dir), -1.0, 1.0);

    if (D < -0.999999)
    { return float4(1.0, 0.0, 0.0, 0.0); }

    const float3 Axis = cross(Up, Dir);
    const float  Len  = length(Axis);

    if (Len < 1e-6)
    { return float4(0.0, 0.0, 0.0, 1.0); }

    return CkParticles_QuatFromAxisAngle(Axis / Len, acos(D));
}

// Pass-through defaults (a behavior overrides only what it changes). Size defaults to a per-Seed-varied value that
// shrinks over life, so even behaviors that never touch Size get non-uniform, animated sprites (salt 7 is reserved
// for size so it stays independent of a behavior's direction/hue randoms). New-contract fields default to the
// camera-sprite renderer with inert material dynamics, so legacy behaviors render exactly as before.
FCkParticles_StageOutput CkParticles_DefaultOutput(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O;
    O.Position = In.Position;
    O.Velocity = In.Velocity;
    O.Color    = float4(1.0, 1.0, 1.0, 1.0);
    const float SizeBase = lerp(18.0, 8.0, CkParticles_NormalizedAge(In)) * lerp(0.65, 1.35, CkParticles_Rand(In.Seed, 7));
    O.Size        = float2(SizeBase, SizeBase);
    O.Scale       = float3(1.0, 1.0, 1.0);
    O.Orientation = float4(0.0, 0.0, 0.0, 1.0);
    O.Dynamic     = float4(0.0, 0.0, 0.0, 0.0);
    O.Rotation    = 0.0;
    O.MeshIndex   = 0;
    O.VisTag      = 0;
    // Sim-space Z-up quad. Only VisTag 4 reads these, but they must never be zero: a degenerate
    // alignment/facing pair collapses the sprite instead of failing visibly.
    O.SpriteAlignment = float3(0.0, 1.0, 0.0);
    O.SpriteFacing    = float3(0.0, 0.0, 1.0);
    O.SubImageIndex   = 0.0;
    return O;
}
