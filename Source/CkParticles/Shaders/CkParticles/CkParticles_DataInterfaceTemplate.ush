// /CkParticles/CkParticles_DataInterfaceTemplate.ush
//
// Delivered to the Niagara GPU translator via UCkParticles_DataInterface::GetParameterDefinitionHLSL ->
// AppendTemplateHLSL. ParameterName is the DI's HLSL symbol; ExecuteStageSymbol is the exact call symbol
// the translated sim invokes (taken from the translator's GeneratedFunctions, so specifier mangling can never
// desync the name). The actual logic lives in the #included behavior files. Comments here must never spell a
// substitution token in braces: FString::Format replaces tokens inside comments too.

#include "/CkParticles/CkParticles_Behaviors.ush"

// The DI's per-instance shader parameters (UCkParticles_DataInterface::FShaderParameters). The block is addressed
// by VisTag and applied below, AFTER CkParticles_ExecuteStage returns — the wrapper is where these are in scope,
// and applying it centrally here is what keeps every behavior unaware that per-part tuning exists.
int    {ParameterName}_PartTuningBandStart;
float4 {ParameterName}_PartTuningRows[CKPARTICLES_MAX_TUNED_PARTS * CKPARTICLES_PART_TUNING_ROWS];

void {ExecuteStageSymbol}(in int BehaviorId, in float DeltaTime, in float Age, in float Lifetime, in float3 InPosition, in float3 InVelocity, in int Seed, in float EmitterAge, in float4 InTuning, out float3 OutPosition, out float3 OutVelocity, out float4 OutColor, out float2 OutSize, out float3 OutScale, out float4 OutOrientation, out float4 OutDynamic, out float OutRotation, out int OutMeshIndex, out int OutVisTag, out float3 OutSpriteAlignment, out float3 OutSpriteFacing, out float OutSubImageIndex)
{
    FCkParticles_StageInput In;
    In.BehaviorId = BehaviorId;
    In.DeltaTime  = DeltaTime;
    In.Age        = Age;
    In.Lifetime   = Lifetime;
    In.Position   = InPosition;
    In.Velocity   = InVelocity;
    In.Seed       = Seed;
    In.EmitterAge = EmitterAge;
    In.Tuning     = InTuning;

    FCkParticles_StageOutput Out = CkParticles_ExecuteStage(In);

    // Per-part tuning, on top of the global one CkParticles_ExecuteStage already applied. NormalizedAge is taken
    // from the TUNED clock (Tuning.w pre-scales Age inside ExecuteStage) so a visibility window is stated in the
    // same normalized life every behavior reads. Mirrored by NDICkParticlesLocal::ExecuteStage_CPU.
    const int PartRow = CkParticles_PartTuningRow(Out.VisTag, {ParameterName}_PartTuningBandStart);
    if (PartRow >= 0)
    {
        const int PartBase = PartRow * CKPARTICLES_PART_TUNING_ROWS;
        CkParticles_ApplyPartTuning(Out, CkParticles_NormalizedAgeOf(Age * InTuning.w, Lifetime),
            {ParameterName}_PartTuningRows[PartBase + 0],
            {ParameterName}_PartTuningRows[PartBase + 1],
            {ParameterName}_PartTuningRows[PartBase + 2],
            {ParameterName}_PartTuningRows[PartBase + 3],
            {ParameterName}_PartTuningRows[PartBase + 4]);
    }

    OutPosition    = Out.Position;
    OutVelocity    = Out.Velocity;
    OutColor       = Out.Color;
    OutSize        = Out.Size;
    OutScale       = Out.Scale;
    OutOrientation = Out.Orientation;
    OutDynamic     = Out.Dynamic;
    OutRotation    = Out.Rotation;
    OutMeshIndex   = Out.MeshIndex;
    OutVisTag      = Out.VisTag;
    OutSpriteAlignment = Out.SpriteAlignment;
    OutSpriteFacing    = Out.SpriteFacing;
    OutSubImageIndex   = Out.SubImageIndex;
}
