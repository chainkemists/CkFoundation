// /CkParticles/Behaviors/Behavior_Slash.ush — BehaviorId 7.
// Anime swipe REPLICATED from Vefects NS_BasicAttack (corpus recipe + material M_VFX_DisAdd_Slash01): a burst of
// oriented sweep MESHES whose SweepErode material pans + dissolves the streak texture along the arc (the mesh
// itself never moves — the motion is all UV), a delayed ring of velocity-streak sparkles (recipe: 15-burst torus,
// 0.06 s delay), and a large dim wind-ghost sweep (recipe: Slash_Wind, uniform scale 1.1, alpha 0.2).
// Spawns through the BURST template: real Age, one swipe per ~1.2 s loop. Keep the CPU mirror in lockstep.
#pragma once
#include "/CkParticles/Common.ush"

FCkParticles_StageOutput CkParticles_Behavior_Slash(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O = CkParticles_DefaultOutput(In);

    const float k = CkParticles_Rand(In.Seed, 0);

    if (k < 0.05) // sweep mesh layers — the swipe itself (recipe: one mesh particle per slash emitter, x3 layers)
    {
        const float t     = saturate(In.Age / 0.42);
        const float Pitch = 1.5707963 + (CkParticles_Rand(In.Seed, 2) - 0.5) * 0.35; // stand the arc upright
        const float Roll  = (CkParticles_Rand(In.Seed, 1) - 0.5) * 0.7;              // fan the layers

        O.Orientation = CkParticles_QuatMul(
            CkParticles_QuatFromAxisAngle(float3(0.0, 1.0, 0.0), Roll),
            CkParticles_QuatFromAxisAngle(float3(1.0, 0.0, 0.0), Pitch));
        O.Position  = float3(0.0, 0.0, 90.0);
        O.Velocity  = float3(0.0, 0.0, 0.0);
        O.VisTag    = 3;
        O.MeshIndex = 0;
        O.Scale     = float3(1.0, 1.0, 1.0) * lerp(1.35, 1.75, CkParticles_Rand(In.Seed, 3));

        // Material drive (recipe dyn-param curves): streak head pans along the arc, dissolve eats it late,
        // emissive boost front-loads the flash.
        O.Dynamic = float4(max(0.0, t - 0.5) * 2.0, 0.35, lerp(-0.55, 0.45, t), 2.2 * (1.0 - t));

        const float  Vis = saturate(1.0 - max(0.0, In.Age - 0.30) / 0.12);
        const float3 c   = lerp(float3(5.0, 3.9, 2.0), float3(5.0, 0.35, 0.75), saturate(t * 1.3)); // white -> hot pink
        O.Color = float4(c * Vis, 0.6 * Vis);
    }
    else if (k < 0.30) // sparkle ring — velocity streaks off the swipe plane (recipe: torus ring, 0.06 s delay)
    {
        const float Life = lerp(0.30, 0.50, CkParticles_Rand(In.Seed, 4));
        const float td   = max(0.0, In.Age - 0.06);
        const float Arc  = saturate(td / Life);
        const float a    = 6.28318530718 * CkParticles_Rand(In.Seed, 5);
        const float jy   = (CkParticles_Rand(In.Seed, 6) - 0.5);

        const float3 P0 = float3(cos(a) * 55.0, jy * 14.0, 90.0 + sin(a) * 55.0);
        const float3 d  = float3(cos(a), jy * 0.6, sin(a));
        const float  s  = lerp(250.0, 550.0, CkParticles_Rand(In.Seed, 7));
        const float  kd = (1.0 - exp(-2.4 * td)) / 2.4;

        O.Position = P0 + d * s * kd;
        O.Velocity = d * s * exp(-2.4 * td);
        O.VisTag   = 1;
        O.Size     = float2(3.5, lerp(20.0, 6.0, Arc));

        const float  Vis = step(0.06, In.Age) * saturate(1.0 - Arc);
        const float3 c   = lerp(float3(4.0, 3.8, 2.7), float3(4.0, 1.8, 0.16), saturate((Arc - 0.15) / 0.5)); // white -> orange (recipe curve)
        O.Color = float4(c * Vis, Vis);
    }
    else if (k < 0.36) // wind ghost — the big dim trailing sweep (recipe: Slash_Wind, scale 1.1, alpha 0.2)
    {
        const float tw   = saturate(max(0.0, In.Age - 0.05) / 0.55);
        const float Roll = (CkParticles_Rand(In.Seed, 1) - 0.5) * 0.5;

        O.Orientation = CkParticles_QuatMul(
            CkParticles_QuatFromAxisAngle(float3(0.0, 1.0, 0.0), Roll),
            CkParticles_QuatFromAxisAngle(float3(1.0, 0.0, 0.0), 1.5707963));
        O.Position  = float3(0.0, 0.0, 90.0);
        O.Velocity  = float3(0.0, 0.0, 0.0);
        O.VisTag    = 3;
        O.MeshIndex = 0;
        O.Scale     = float3(1.0, 1.0, 1.0) * (1.95 * (1.0 + 0.1 * tw));
        O.Dynamic   = float4(tw * 0.9, 0.30, lerp(-0.38, 0.38, tw), 0.3);

        const float Vis = saturate(tw / 0.25) * saturate(1.0 - max(0.0, tw - 0.6) / 0.4);
        O.Color = float4(float3(1.0, 0.62, 0.72) * Vis, 0.22 * Vis);
    }
    else // surplus burst particles — fully hidden (burst count is shared across all behaviors)
    {
        O.Color = float4(0.0, 0.0, 0.0, 0.0);
        O.Size  = float2(0.0, 0.0);
        O.Scale = float3(0.0, 0.0, 0.0);
    }
    return O;
}
