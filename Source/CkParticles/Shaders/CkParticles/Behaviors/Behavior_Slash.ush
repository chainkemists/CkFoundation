// /CkParticles/Behaviors/Behavior_Slash.ush — BehaviorId 7.
// Melee slash crescent: particles spread across a swept arc in the local XY plane (the age range paints the sweep),
// with per-Seed radius jitter for thickness. Fades toward the trailing edge. Tint white -> cyan. Self-driving.
#pragma once
#include "/CkParticles/Common.ush"

FCkParticles_StageOutput CkParticles_Behavior_Slash(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O = CkParticles_DefaultOutput(In);

    const float n   = CkParticles_NormalizedAge(In);
    const float Ang = lerp(-1.3, 1.3, n);                       // ~150-degree sweep across the particle ages
    const float Rad = lerp(120.0, 165.0, CkParticles_Rand(In.Seed, 1));
    const float Z   = (CkParticles_Rand(In.Seed, 2) - 0.5) * 12.0;

    O.Position = float3(cos(Ang) * Rad, sin(Ang) * Rad, Z);
    O.Color    = lerp(float4(3.0, 3.0, 3.0, 1.0), float4(0.3, 1.2, 2.0, 1.0), n) * (1.0 - n * 0.5);

    return O;
}
