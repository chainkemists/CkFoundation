// /CkParticles/Behaviors/Behavior_Nova.ush — BehaviorId 8.
// Expanding flat shockwave ring in the local XY plane; grows and fades over life, per-Seed angle + radius jitter.
// Tint white-hot -> orange. Self-driving. Knobs below — keep the CPU mirror in lockstep.
#pragma once
#include "/CkParticles/Common.ush"

FCkParticles_StageOutput CkParticles_Behavior_Nova(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O = CkParticles_DefaultOutput(In);

    const float n = CkParticles_NormalizedAge(In);
    const float k = CkParticles_Rand(In.Seed, 3);

    if (k < 0.14) // dome: Shell carrier mesh swelling and dissolving (fresnel rim material)
    {
        O.Position  = float3(0.0, 0.0, 0.0);
        O.Velocity  = float3(0.0, 0.0, 0.0);
        O.VisTag    = 3;
        O.MeshIndex = 2;
        O.Scale     = float3(1.0, 1.0, 1.0) * lerp(0.15, 2.2, n);
        O.Dynamic   = float4(n * 0.9, 0.2, 0.0, 2.5 * (1.0 - n));
        O.Color     = float4(float3(1.5, 0.9, 0.35) * (1.0 - n), 1.0 - n);
        return O;
    }
    if (k < 0.32) // ground shockwave: Disc carrier mesh racing outward, eroding at the rim
    {
        O.Position  = float3(0.0, 0.0, 2.0);
        O.Velocity  = float3(0.0, 0.0, 0.0);
        O.VisTag    = 3;
        O.MeshIndex = 3;
        O.Scale     = float3(1.0, 1.0, 1.0) * lerp(0.1, 3.8, n);
        O.Dynamic   = float4(n, 0.25, -n * 0.8, 1.8 * (1.0 - n));
        O.Color     = float4(float3(2.6, 1.1, 0.2) * (1.0 - n), 1.0 - n);
        return O;
    }

    const float A      = CkParticles_Rand(In.Seed, 1) * 6.28318530718;
    const float Rad    = lerp(10.0, 380.0, n);                 // expand outward
    const float Jitter = (CkParticles_Rand(In.Seed, 2) - 0.5) * 16.0;

    O.Position = float3(cos(A) * (Rad + Jitter), sin(A) * (Rad + Jitter), 0.0);
    O.Color    = lerp(float4(3.0, 2.4, 1.0, 1.0), float4(1.2, 0.3, 0.0, 1.0), n) * (1.0 - n);

    return O;
}
