// /CkParticles/Behaviors/Behavior_MuzzleFlash.ush — BehaviorId 9.
// AR muzzle flash recreated from sA_ShootingVfxPack NS_AR_Muzzleflash_1/2 (corpus translation sheet): a hot core
// flash at the barrel, slow flecks in a wide cone, fast drag-damped sparks in a tight cone. Barrel axis = +X
// (aim via spawn rotation, like Beam). The template spawns continuously, so each particle REPLAYS the one-shot
// arc every cycle with a per-Seed phase — reads as automatic fire; a burst-spawn template makes it a true one-shot.
// Keep the CPU mirror in lockstep.
#pragma once
#include "/CkParticles/Common.ush"

FCkParticles_StageOutput CkParticles_Behavior_MuzzleFlash(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O = CkParticles_DefaultOutput(In);

    const float Cycle = 0.35;
    const float t     = frac(In.Age / Cycle + CkParticles_Rand(In.Seed, 9)) * Cycle;
    const float m     = t / Cycle;
    const float k     = CkParticles_Rand(In.Seed, 0);

    const float3 Hot = lerp(float3(100.0, 18.9, 0.54), float3(10.0, 8.0, 1.0), m); // white-hot -> amber (recipe curve)

    if (k < 0.12) // core flash: dies within the first 0.08 s of the cycle
    {
        const float Vis  = saturate(1.0 - t / 0.08);
        const float Grow = lerp(0.5, 1.3, CkParticles_Rand(In.Seed, 1)) * (0.6 + 0.8 * saturate(t / 0.03));
        O.Position = float3(18.0, 0.0, 0.0);
        O.Velocity = float3(0.0, 0.0, 0.0);
        O.Size     = float2(55.0, 40.0) * Grow;
        O.Color    = float4(Hot * Vis, Vis);
    }
    else if (k < 0.4) // flecks: wide cone (43.6 deg half), 50-100 cm/s, ~0.25 s
    {
        const float u  = CkParticles_Rand(In.Seed, 2);
        const float az = 6.28318530718 * CkParticles_Rand(In.Seed, 3);
        const float th = 0.7605 * sqrt(u);
        const float3 d = float3(cos(th), sin(th) * cos(az), sin(th) * sin(az));
        const float s  = lerp(50.0, 100.0, CkParticles_Rand(In.Seed, 4));
        const float Vis = saturate(1.0 - t / 0.25);
        O.Position = d * s * t;
        O.Velocity = d * s;
        O.VisTag   = 1;
        O.Size     = float2(2.2, 7.0);
        O.Color    = float4(Hot * Vis, Vis);
    }
    else // sparks: tight cone (30 deg half), 250-500 cm/s with linear drag 1 (integrated)
    {
        const float u  = CkParticles_Rand(In.Seed, 5);
        const float az = 6.28318530718 * CkParticles_Rand(In.Seed, 6);
        const float th = 0.5236 * sqrt(u);
        const float3 d = float3(cos(th), sin(th) * cos(az), sin(th) * sin(az));
        const float s  = lerp(250.0, 500.0, CkParticles_Rand(In.Seed, 7));
        const float Vis = saturate(1.0 - t / 0.20);
        O.Position = d * s * (1.0 - exp(-t));
        O.Velocity = d * s * exp(-t);
        O.VisTag   = 1;
        O.Size     = float2(1.6, 9.0) * saturate(1.0 - t / 0.18);
        O.Color    = float4(37.0, 5.58, 0.5, 1.0) * Vis;
    }
    return O;
}
