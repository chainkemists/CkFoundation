// /CkParticles/Behaviors/Behavior_SparksBurst.ush — BehaviorId 13.
// Welding-style spark fountain recreated from StarterContent P_Sparks (corpus translation sheet; cross-checked
// vs Shooter_VFXPack projectile sparks): hot blue-white streaks burst from a point on the upper hemisphere at
// 160 cm/s, yanked down by -2000 gravity over a 0.5-0.7 s arc; ~1.5% of seeds render as the 0.1 s flash pop.
// Cycled continuous spawn (see MuzzleFlash note). Keep the CPU mirror in lockstep.
#pragma once
#include "/CkParticles/Common.ush"

FCkParticles_StageOutput CkParticles_Behavior_SparksBurst(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O = CkParticles_DefaultOutput(In);

    // Burst template: real Age (one fountain per ~1.2 s loop) — the frac-cycle replay is retired.
    const float t = In.Age;
    const float k = CkParticles_Rand(In.Seed, 0);

    if (k < 0.985) // streaks: upper hemisphere, 160 cm/s radial, gravity -2000 (recipe numbers)
    {
        const float z  = CkParticles_Rand(In.Seed, 1);
        const float a  = 6.28318530718 * CkParticles_Rand(In.Seed, 2);
        const float rr = sqrt(saturate(1.0 - z * z));
        const float3 d = float3(rr * cos(a), rr * sin(a), z);

        const float Arc = t / lerp(0.5, 0.7, CkParticles_Rand(In.Seed, 3)); // 0..1 within this spark's arc

        O.Position = d * 2.0 + d * 160.0 * t + float3(0.0, 0.0, -1000.0 * t * t);
        O.Velocity = d * 160.0 + float3(0.0, 0.0, -2000.0 * t);
        O.VisTag   = 1;
        O.Size     = float2(2.0, 15.0 * lerp(1.0, 0.3, saturate(Arc)));

        const float3 c = lerp(float3(2.0, 6.0, 15.0), float3(1.0, 3.0, 7.0), saturate((Arc - 0.1) / 0.4));
        const float  a2 = saturate(1.5 * (1.0 - saturate((Arc - 0.7) / 0.3)));
        O.Color = float4(c * a2, a2);
    }
    else // flash pop: 0.1 s, size 10-20 scaling 0.1x -> 3x by a third in (recipe curve)
    {
        const float s   = lerp(10.0, 20.0, CkParticles_Rand(In.Seed, 4)) * lerp(0.1, 3.0, saturate(t / 0.03));
        const float Vis = saturate(1.0 - t / 0.1);
        O.Position = float3(0.0, 0.0, 4.0);
        O.Velocity = float3(0.0, 0.0, 0.0);
        O.Size     = float2(s, s);
        O.Color    = float4(2.0, 10.0, 20.0, 1.0) * (1.5 * Vis);
    }
    return O;
}
