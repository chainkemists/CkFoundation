// /CkParticles/Behaviors/Behavior_LightningMuzzle.ush — BehaviorId 39.
//
// Faithful re-port of Vefects NS_Lightning_Muzzle. Recipe + corpus evidence:
// CkParticles/Cookbook/NS_Lightning_Muzzle.md — every number below is a source value from §2/§5, not a tuning.
//
// Seventeen emitters over a Loop-Once 2.0 s system, two of them DISABLED (the world-space Arrow pair, which
// is deliberately not recreated). The fifteen live ones cover every renderer class the pipeline has: ten
// camera sprites, one of them a 2x2 flipbook; one velocity-aligned streak; three meshes; and the LightningArc
// PAIR, the cookbook's second ribbon-bearing row and its first with two ribbon IDS on one renderer.
// PS_CkParticles_Template_LightningMuzzle is 2.0 s loop / 0.6 s lifetime / burst 24, with a ribbon emitter
// bursting 30 arc points.
//
// The muzzle fires along +X, which is already the roster convention for MuzzleFlash and Tracer, so nothing
// here is re-aimed. Every burst in this system is at t = 0, so no layer carries a spawn beat.
//
// ---- The arcs (C6c's second shape) -----------------------------------------------------------------------
//
// Each arc emitter carries a burst AND a Spawn Rate that FALLS 80 -> 0 across its own 0.3 s window. A rate
// that a stateless behavior would have to read the emitter clock for becomes a BURST with solved spawn times
// instead: the source's cumulative count N(s) = 80s - (400/3)s^2 inverts in closed form, so arc point i is
// released at 0.3*(1 - sqrt(1 - (i + 0.5)/12)) and the twelve points land exactly where the falling rate
// would have put them. The burst points sit at zero. Spawn order IS link order IS ribbon order.
//
// Both arcs are bent by a Curl Noise Force. Its 45 degree cone mask is INERT (`Mask Curl Noise = false`) and
// so is the 1000 unit/s Speed Limit beside it (`Clamp Velocity = false`), so the path is an unclamped
// advection and CkParticles_CurlPath expresses it directly.
//
// Keep the CPU mirror (NDICkParticlesLocal::ExecuteStage_CPU case 39) in lockstep.
#pragma once
#include "/CkParticles/Common.ush"

#define CKP_LM_BURST_SLOTS   24

// Renderer tags, all row-declared on this behavior's own cadence row (recipe §6.2). 184 rides the row's
// SECOND emitter, the ribbon one.
#define CKP_LM_VIS_PART01     175
#define CKP_LM_VIS_PART02     176
#define CKP_LM_VIS_PART01BR   177
#define CKP_LM_VIS_PART04     178
#define CKP_LM_VIS_LIGHTNING  179
#define CKP_LM_VIS_PART03BR   180
#define CKP_LM_VIS_SPIKE      181
#define CKP_LM_VIS_SPOT       182
#define CKP_LM_VIS_BEAM       183
#define CKP_LM_VIS_ARC        184

// The two plane meshes draw with Facing Default under an Initial Mesh Orientation that carries mesh-local +X
// onto world -Z. The carrier is built with its width on X and its length on Z, so that is a quarter turn
// about +Y and nothing else.
#define CKP_LM_HALF_PI 1.57079632679

// The arc ribbon. Twelve rate points per arc on top of one and five burst points; the pair is separated by
// RIBBON ID (which rides MeshIndex) rather than by a second renderer.
#define CKP_LM_ARC_POINTS       30
#define CKP_LM_ARC1_COUNT       13   // 1 burst + 12 solved rate points
#define CKP_LM_ARC_RATE_POINTS  12
#define CKP_LM_ARC_WINDOW      0.3
#define CKP_LM_ARC_CURL_SEED     11u  // the source's own Random Seed
// The source figure is an ACCELERATION where CurlPath advects with a VELOCITY (the NS_FireBall_Projectile
// conversion, recipe §9): the strength curve falls 10000 -> 0 over the life, so its time average is 5000, and
// the constant-velocity path covering the same ground over a life L is 0.5 * 5000 * L. That is divided by the
// MEASURED mean magnitude of this plugin's own curl field over the region the arcs visit (0.7400 at frequency
// 0.5 and 0.7426 at 1.0, both over 4000 samples within +-400 units at seed 11 — the same field, sampled at
// two rates, so the two means agree).
#define CKP_LM_ARC_CURL_ACCEL  5000.0
#define CKP_LM_ARC1_CURL_FREQ     0.5
#define CKP_LM_ARC2_CURL_FREQ     1.0
#define CKP_LM_ARC1_FIELD_MEAN 0.7400
#define CKP_LM_ARC2_FIELD_MEAN 0.7426

FCkParticles_StageOutput CkParticles_LightningMuzzle_Hidden(FCkParticles_StageOutput O)
{
    O.Color = float4(0.0, 0.0, 0.0, 0.0);
    O.Size  = float2(0.0, 0.0);
    O.Scale = float3(0.0, 0.0, 0.0);
    return O;
}

// Seven emitters carry no Color module at all: their Initialize colour survives and one Scale Color ramps the
// alpha linearly to zero, under one shared size curve. Byte-identical to NS_Lightning_Cast's shared fade.
float CkParticles_LightningMuzzle_SharedFade(float T)
{
    return CkParticles_Key2(T, 0.0, 1.0, 1.0, 0.0);
}

float CkParticles_LightningMuzzle_SharedGrow(float T)
{
    return CkParticles_Key3(T, 0.0, 0.5, 0.1, 1.0, 1.0, 1.0);
}

// The Lightning layer's Sprite Rotation Rate in degrees per second: 0 until t = 0.1, 90 until t = 0.9, then 0.
// The accumulated angle is its exact integral in units of normalized life. Same curve as NS_Lightning_Cast's.
float CkParticles_LightningMuzzle_SpinIntegral(float T)
{
    const float t = saturate(T);
    const float A = min(t, 0.1);
    float Sum = 0.5 * A * (90.0 * A / 0.1);

    if (t > 0.1)
    {
        const float B = min(t, 0.9);
        Sum += 0.5 * (B - 0.1) * (90.0 + 90.0 * (0.9 - B) / 0.8);
    }
    return Sum;
}

// Five emitters spawn through the same shape: a sphere of radius 10 squashed on Y and Z, restricted to the
// +X hemisphere, filled through its VOLUME (Surface Only is false, so the radius takes a cube root).
float3 CkParticles_LightningMuzzle_HemiPoint(int Seed, float3 Scale)
{
    float3 Dir = CkParticles_RandDir(Seed);
    Dir.x = abs(Dir.x);

    const float R = 10.0 * pow(CkParticles_Rand(Seed, 3), 1.0 / 3.0);
    return Dir * R * Scale;
}

// Add Velocity from Point launches along the spawn offset, so the squashed shape — not the unit sphere it was
// drawn on — is what sets the direction. A point drawn exactly at the origin has none, and the hemisphere axis
// is the only direction that degenerate case can mean.
float3 CkParticles_LightningMuzzle_Radial(float3 Spawn)
{
    const float L = length(Spawn);
    return L > 1.0e-6 ? Spawn / L : float3(1.0, 0.0, 0.0);
}

// Where along its own 0.3 s window an arc point is released. Point 0 is the burst; the rest invert the
// source's falling spawn rate.
float CkParticles_LightningMuzzle_ArcTime(int RatePoint)
{
    if (RatePoint < 0)
    { return 0.0; }

    const float Fraction = (float(RatePoint) + 0.5) / float(CKP_LM_ARC_RATE_POINTS);
    return CKP_LM_ARC_WINDOW * (1.0 - sqrt(saturate(1.0 - Fraction)));
}

// The arc branch. Runs on the RIBBON emitter's particles only.
FCkParticles_StageOutput CkParticles_LightningMuzzle_Arc(FCkParticles_StageInput In)
{
    FCkParticles_StageOutput O = CkParticles_DefaultOutput(In);

    O.Velocity = float3(0.0, 0.0, 0.0);
    // M_VFX_DisAdd_Flat02's parent declares no dynamic parameters, so the source's writes are inert.
    O.Dynamic  = float4(0.0, 0.0, 0.0, 0.0);
    O.VisTag   = CKP_LM_VIS_ARC;

    const int LocalSeed = CkParticles_LocalSeed(In.Seed);
    const int Point     = ((LocalSeed % CKP_LM_ARC_POINTS) + CKP_LM_ARC_POINTS) % CKP_LM_ARC_POINTS;
    const int IsArc02   = Point < CKP_LM_ARC1_COUNT ? 0 : 1;

    O.MeshIndex = IsArc02;

    // Arc_01 is one burst point then twelve solved ones; Arc_02 is five then twelve.
    const int Within    = IsArc02 == 0 ? Point : Point - CKP_LM_ARC1_COUNT;
    const int BurstHead = IsArc02 == 0 ? 1 : 5;
    const int RatePoint = Within - BurstHead;

    const float SpawnTime = CkParticles_LightningMuzzle_ArcTime(RatePoint);
    const float Life      = lerp(0.2, 0.3, CkParticles_Rand(In.Seed, 1));

    // Burst at loop start, so the particle's own age IS the loop clock the arc window is measured against.
    const float PointAge = In.Age - SpawnTime;

    const float3 Spawn = CkParticles_LightningMuzzle_HemiPoint(In.Seed, float3(1.0, 0.2, 0.2));
    const float3 V0    = CkParticles_LightningMuzzle_Radial(Spawn) * lerp(10.0, 50.0, CkParticles_Rand(In.Seed, 6))
                       + float3(IsArc02 == 0
                            ? lerp(700.0,  1500.0, CkParticles_Rand(In.Seed, 11))
                            : lerp(2500.0, 3000.0, CkParticles_Rand(In.Seed, 11)), 0.0, 0.0);

    const float t = saturate(max(PointAge, 0.0) / Life);

    // Arc_01 brakes to a standstill; Arc_02 keeps a fifth of its launch speed.
    const float Tail   = IsArc02 == 0 ? 0.0 : 0.2;
    const float Travel = CkParticles_Int2(t, 1.0, Tail) * Life;

    const float Freq      = IsArc02 == 0 ? CKP_LM_ARC1_CURL_FREQ  : CKP_LM_ARC2_CURL_FREQ;
    const float FieldMean = IsArc02 == 0 ? CKP_LM_ARC1_FIELD_MEAN : CKP_LM_ARC2_FIELD_MEAN;
    const float Strength  = 0.5 * CKP_LM_ARC_CURL_ACCEL * Life / FieldMean;

    O.Position = Spawn + V0 * Travel
               + (CkParticles_CurlPath(Spawn, max(PointAge, 0.0), Freq, Strength, CKP_LM_ARC_CURL_SEED) - Spawn);
    O.Velocity = V0 * CkParticles_Key2(t, 0.0, 1.0, 1.0, Tail);

    if (PointAge < 0.0 || PointAge > Life)
    { return CkParticles_LightningMuzzle_Hidden(O); }

    const float A = CkParticles_Key4(t, 0.0, 0.0, 0.220948, 1.0, 0.51313, 1.0, 1.0, 0.0);

    if (IsArc02 == 0)
    {
        O.Color = float4(
            CkParticles_Key2(t, 0.511923, 1.0, 0.813764, 0.584079),
            CkParticles_Key2(t, 0.511923, 1.0, 0.813764, 0.06301),
            1.0,
            A);
    }
    else
    {
        O.Color = float4(
            CkParticles_Key2(t, 0.511923, 0.135751, 0.813764, 0.570314),
            CkParticles_Key2(t, 0.511923, 0.036,    0.813764, 0.0319999),
            1.0,
            0.5 * A);
    }

    // Ribbon width is ONE float read at Particles.SpriteSize's offset, i.e. Size.x.
    const float Base  = IsArc02 == 0
        ? lerp(7.0, 12.0, CkParticles_Rand(In.Seed, 8))
        : lerp(2.0,  4.0, CkParticles_Rand(In.Seed, 8));
    const float Width = Base * CkParticles_Key3(t, 0.0, 0.0, 0.2, 1.0, 1.0, 0.4);

    O.Size = float2(Width, Width);
    return O;
}

FCkParticles_StageOutput CkParticles_Behavior_LightningMuzzle(FCkParticles_StageInput In)
{
    if (CkParticles_IsRibbonSeed(In.Seed))
    { return CkParticles_LightningMuzzle_Arc(In); }

    FCkParticles_StageOutput O = CkParticles_DefaultOutput(In);

    O.Velocity = float3(0.0, 0.0, 0.0);
    O.Position = float3(0.0, 0.0, 0.0);
    O.Dynamic  = float4(0.0, 0.0, 0.0, 0.0);

    // Burst UniqueIDs are sequential, so the modulo draws exactly the source's per-emitter counts. This row
    // declares no spawn rate, so there is one population and no spawn phase to read.
    const int Slot = ((In.Seed % CKP_LM_BURST_SLOTS) + CKP_LM_BURST_SLOTS) % CKP_LM_BURST_SLOTS;

    // ---- Glow_01 / Glow_02 / Glow_03: the three shells that open the flash. None carries a Color module, so
    // each holds its Initialize colour and only fades. Byte-identical palette to NS_Lightning_Cast's trio ----
    if (Slot < 3)
    {
        const float Life = Slot == 2 ? 0.2 : 0.4;

        if (In.Age > Life)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float t    = saturate(In.Age / Life);
        const float Grow = CkParticles_LightningMuzzle_SharedGrow(t);
        const float A    = CkParticles_LightningMuzzle_SharedFade(t);

        if (Slot == 0)
        {
            O.Color   = float4(0.0648033, 0.0307135, 1.0, A);
            O.Size    = float2(550.0 * Grow, 550.0 * Grow);
            O.Dynamic = float4(1.0, 0.0, 0.0, 0.0);
            O.VisTag  = CKP_LM_VIS_PART01;
            return O;
        }

        if (Slot == 1)
        {
            O.Color  = float4(0.863157, 0.0262412, 1.0, A);
            O.Size   = float2(200.0 * Grow, 200.0 * Grow);
            O.VisTag = CKP_LM_VIS_PART02;
            return O;
        }

        O.Color   = float4(1.0, 0.819765, 0.499, A);
        O.Size    = float2(250.0 * Grow, 250.0 * Grow);
        O.Dynamic = float4(2.0, 0.0, 0.0, 0.0);
        O.VisTag  = CKP_LM_VIS_PART01;
        return O;
    }

    // ---- Sparkles: four motes thrown down the barrel off a thin half-cigar. Their velocity-strength range
    // is authored INVERTED (Min 500, Max 200) and is transcribed as authored rather than normalized ----
    if (Slot < 7)
    {
        const float Life = lerp(0.3, 0.6, CkParticles_Rand(In.Seed, 1));

        if (In.Age > Life)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float  t     = saturate(In.Age / Life);
        const float3 Spawn = CkParticles_LightningMuzzle_HemiPoint(In.Seed, float3(1.0, 0.1, 0.1));
        const float3 V0    = CkParticles_LightningMuzzle_Radial(Spawn) * lerp(500.0, 200.0, CkParticles_Rand(In.Seed, 6))
                           + float3(lerp(500.0, 2000.0, CkParticles_Rand(In.Seed, 11)), 0.0, 0.0);

        O.Position = Spawn + V0 * (CkParticles_Int3(t, 0.2, 1.0, 0.15, 0.0) * Life);
        O.Velocity = V0 * CkParticles_Key3(t, 0.0, 1.0, 0.2, 0.15, 1.0, 0.0);

        O.Color = float4(
            CkParticles_Key2(t, 0.511923, 0.296138, 0.876547, 0.0),
            CkParticles_Key2(t, 0.511923, 0.571125, 0.876547, 0.0896671),
            1.0,
            CkParticles_Key2(t, 0.51313, 1.0, 1.0, 0.0));

        const float Base = lerp(10.0, 20.0, CkParticles_Rand(In.Seed, 8));
        const float Grow = CkParticles_Key3(t, 0.0, 0.0, 0.1, 1.0, 1.0, 0.0);

        O.Size     = float2(Base * Grow, Base * Grow);
        O.Rotation = CkParticles_Rand(In.Seed, 4) * 360.0;
        O.Dynamic  = float4(1.0, 0.0, 0.0, 0.0);
        O.VisTag   = CKP_LM_VIS_PART01BR;
        return O;
    }

    // ---- Flare_01 / Flare_02: the cyan and mint pips, identical but for their Initialize colour ----
    if (Slot < 9)
    {
        if (In.Age > 0.5)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float t    = saturate(In.Age / 0.5);
        const float Grow = CkParticles_LightningMuzzle_SharedGrow(t);
        const float A    = CkParticles_LightningMuzzle_SharedFade(t);

        O.Color = Slot == 7
            ? float4(0.102242, 0.658375, 1.0,      0.2   * A)
            : float4(0.102242, 1.0,      0.838799, 0.258 * A);
        O.Size    = float2(50.0 * Grow, 50.0 * Grow);
        O.Dynamic = float4(1.0, 0.0, 0.0, 0.0);
        O.VisTag  = CKP_LM_VIS_PART02;
        return O;
    }

    // ---- Sparkles_Stretched: three velocity-aligned streaks fired hard down the barrel, lengthening up to
    // 2x with speed and pinching to a fifth of their length as they brake ----
    if (Slot < 12)
    {
        const float Life = lerp(0.3, 0.4, CkParticles_Rand(In.Seed, 1));

        if (In.Age > Life)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float  t     = saturate(In.Age / Life);
        const float3 Spawn = CkParticles_LightningMuzzle_HemiPoint(In.Seed, float3(1.0, 0.2, 0.2));
        const float3 V0    = CkParticles_LightningMuzzle_Radial(Spawn) * lerp(200.0, 800.0, CkParticles_Rand(In.Seed, 6))
                           + float3(lerp(1000.0, 3000.0, CkParticles_Rand(In.Seed, 11)), 0.0, 0.0);

        O.Position = Spawn + V0 * (CkParticles_Int3(t, 0.2, 1.0, 0.15, 0.0) * Life);
        O.Velocity = V0 * CkParticles_Key3(t, 0.0, 1.0, 0.2, 0.15, 1.0, 0.0);

        O.Color = float4(
            CkParticles_Key4(t, 0.0, 1.0,      0.079686, 1.0,      0.290975, 0.646925, 1.0, 0.223228),
            CkParticles_Key4(t, 0.0, 0.913099, 0.079686, 0.134,    0.290975, 0.14,     1.0, 0.0),
            CkParticles_Key4(t, 0.0, 0.584079, 0.079686, 0.731716, 0.290975, 1.0,      1.0, 0.116971),
            0.8 * CkParticles_Key2(t, 0.080893, 1.0, 1.0, 0.0));

        const float Width  = lerp(25.0, 40.0, CkParticles_Rand(In.Seed, 8));
        const float Length = lerp(80.0, 90.0, CkParticles_Rand(In.Seed, 12));
        const float Grow   = CkParticles_Key3(t, 0.0, 0.0, 0.1, 1.0, 1.0, 0.0);
        const float Taper  = CkParticles_Key3(t, 0.0, 1.0, 0.3, 0.25, 1.0, 0.2);

        // Scale Sprite Size by Speed: length only, 1x up to the 1000-unit threshold and 2x at or past it.
        const float SpeedFactor = lerp(1.0, 2.0, saturate(length(O.Velocity) / 1000.0));

        O.Size   = float2(Width * Grow, Length * Grow * Taper * SpeedFactor);
        O.VisTag = CKP_LM_VIS_PART04;
        return O;
    }

    // ---- Lightning: three bolts on the 2x2 sheet, every one of them sitting at the muzzle (its Sphere
    // Location radius is ZERO) and separated by a spinning random rotation, a random size and a random start
    // on the frame run. The STROBING alpha — on, off, on, off, on — is the whole read ----
    if (Slot < 15)
    {
        const float Life = lerp(0.3, 0.5, CkParticles_Rand(In.Seed, 1));

        if (In.Age > Life)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float t = saturate(In.Age / Life);

        O.Color = float4(
            CkParticles_Key5(t, 0.0, 1.0,      0.0748566, 1.0, 0.598853, 1.0,      0.811349, 0.287441,  1.0, 0.0512695),
            CkParticles_Key5(t, 0.0, 0.745404, 0.0748566, 1.0, 0.598853, 0.147027, 0.811349, 0.0409152, 1.0, 0.0409152),
            CkParticles_Key5(t, 0.0, 0.304987, 0.0748566, 1.0, 0.598853, 0.982251, 0.811349, 1.0,       1.0, 1.0),
            CkParticles_Key5(t, 0.162994, 1.0, 0.329611, 0.0, 0.504679, 1.0, 0.746152, 0.0, 0.959855, 1.0));

        const float Base = lerp(30.0, 100.0, CkParticles_Rand(In.Seed, 8));
        const float Grow = CkParticles_Key3(t, 0.0, 0.0, 0.1, 0.8, 1.0, 1.0);
        O.Size = float2(Base * Grow, Base * Grow);

        O.Rotation = CkParticles_Rand(In.Seed, 4) * 360.0
                   + Life * CkParticles_LightningMuzzle_SpinIntegral(t);

        // Sub UV Animation in LINEAR mode: the run starts at frame 0 on every particle, and its declared End
        // Frame of 4 on a four-frame sheet wraps the fifth step back onto frame 0 (recipe §13).
        O.SubImageIndex = fmod(min(floor(t * 5.0), 4.0), 4.0);

        O.Dynamic = float4(CkParticles_Key4(t, 0.0, 1.0, 0.2, -1.0, 0.3, 0.875, 1.0, -1.0), 0.0, 0.0, 0.0);
        O.VisTag  = CKP_LM_VIS_LIGHTNING;
        return O;
    }

    // ---- Flare_03: two identical orange pips that overlay exactly, and Flare_04, the near-transparent one
    // carrying the system's second dissolve of 2 ----
    if (Slot < 18)
    {
        if (In.Age > 0.2)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float t    = saturate(In.Age / 0.2);
        const float Grow = CkParticles_LightningMuzzle_SharedGrow(t);
        const float A    = CkParticles_LightningMuzzle_SharedFade(t);

        if (Slot < 17)
        {
            O.Color   = float4(1.0, 0.4563, 0.111, 0.737104 * A);
            O.Size    = float2(250.0 * Grow, 250.0 * Grow);
            O.Dynamic = float4(1.0, 0.0, 0.0, 0.0);
            O.VisTag  = CKP_LM_VIS_PART03BR;
            return O;
        }

        O.Color   = float4(1.0, 0.384719, 0.0889999, 0.0371041 * A);
        O.Size    = float2(80.0 * Grow, 80.0 * Grow);
        O.Dynamic = float4(2.0, 0.0, 0.0, 0.0);
        O.VisTag  = CKP_LM_VIS_PART01BR;
        return O;
    }

    // ---- Spikes: four pyramids fired down the barrel, pointed along their own velocity. They carry NO Color
    // module at all, so the violet is constant for the whole 0.15 s and only the mesh scale animates — and its
    // Z curve has no third key, so the spikes FLATTEN to a line rather than shrinking away ----
    if (Slot < 22)
    {
        if (In.Age > 0.15)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float  t     = saturate(In.Age / 0.15);
        const float3 Spawn = CkParticles_LightningMuzzle_HemiPoint(In.Seed, float3(1.0, 0.2, 0.2));
        const float3 V0    = CkParticles_LightningMuzzle_Radial(Spawn) * lerp(200.0, 50.0, CkParticles_Rand(In.Seed, 6))
                           + float3(lerp(100.0, 500.0, CkParticles_Rand(In.Seed, 11)), 0.0, 0.0);

        O.Position = Spawn + V0 * (CkParticles_Int3(t, 0.2, 1.0, 0.15, 0.0) * 0.15);
        O.Velocity = V0 * CkParticles_Key3(t, 0.0, 1.0, 0.2, 0.15, 1.0, 0.0);

        // Mesh Scale's Z range is authored inverted (0.6 down to 0.4) and is transcribed as authored.
        const float BaseZ = lerp(0.6, 0.4, CkParticles_Rand(In.Seed, 15));
        const float Flat  = CkParticles_Key3(t, 0.0, 0.0, 0.2, 1.0, 1.0, 0.0);
        const float Along = CkParticles_Key2(t, 0.0, 0.0, 0.2, 1.0);

        O.Scale       = float3(0.1 * Flat, 0.1 * Flat, BaseZ * Along);
        O.Orientation = CkParticles_QuatFromZTo(CkParticles_LightningMuzzle_Radial(V0));
        O.MeshIndex   = 0;
        O.Size        = float2(0.0, 0.0);
        O.Color       = float4(0.871367, 0.06301, 1.0, 0.5);
        O.VisTag      = CKP_LM_VIS_SPIKE;
        return O;
    }

    // ---- LightningSpot: the wide ground-glow plane. Its RGB curves carry a single key each, so only the
    // alpha moves, and it is scaled to a TENTH by the emitter's Color.Scale Alpha ----
    if (Slot == 22)
    {
        if (In.Age > 0.3)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float t = saturate(In.Age / 0.3);

        O.Color       = float4(0.354443, 0.2, 1.0,
                               0.1 * CkParticles_Key3(t, 0.0, 0.0, 0.317537, 1.0, 1.0, 0.0));
        O.Scale       = float3(1.2 * CkParticles_Key3(t, 0.0, 0.5, 0.2, 1.0, 1.0, 0.0),
                               1.4 * CkParticles_Key2(t, 0.0, 0.0, 1.0, 1.0),
                               5.0 * CkParticles_Key3(t, 0.0, 0.0, 0.2, 0.75, 1.0, 1.0));
        O.Orientation = CkParticles_QuatFromAxisAngle(float3(0.0, 1.0, 0.0), CKP_LM_HALF_PI);
        O.MeshIndex   = 0;
        O.Size        = float2(0.0, 0.0);
        O.VisTag      = CKP_LM_VIS_SPOT;
        return O;
    }

    // ---- LightningBeam: the bolt plane down the barrel, the only layer with a position offset. Its alpha is
    // a SINGLE key, so it never fades — it leaves entirely through the dissolve ramp 1 -> -1 ----
    {
        if (In.Age > 0.3)
        { return CkParticles_LightningMuzzle_Hidden(O); }

        const float t = saturate(In.Age / 0.3);

        O.Position = float3(-30.0, 0.0, 0.0);

        O.Color = float4(
            CkParticles_Key5(t, 0.0, 1.0,      0.074857, 1.0, 0.598853, 1.0,      0.811349, 0.287441, 1.0, 0.051269),
            CkParticles_Key5(t, 0.0, 0.745404, 0.074857, 1.0, 0.598853, 0.147027, 0.811349, 0.040915, 1.0, 0.040915),
            CkParticles_Key5(t, 0.0, 0.304987, 0.074857, 1.0, 0.598853, 0.982251, 0.811349, 1.0,      1.0, 1.0),
            1.0);

        O.Scale       = float3(2.5 * CkParticles_Key2(t, 0.0, 0.5, 0.2, 1.0),
                               2.5 * CkParticles_Key2(t, 0.0, 0.0, 1.0, 1.0),
                               4.0 * CkParticles_Key3(t, 0.0, 0.0, 0.2, 0.75, 1.0, 1.0));
        O.Orientation = CkParticles_QuatFromAxisAngle(float3(0.0, 1.0, 0.0), CKP_LM_HALF_PI);
        O.MeshIndex   = 0;
        O.Size        = float2(0.0, 0.0);
        O.Dynamic     = float4(CkParticles_Key2(t, 0.0, 1.0, 1.0, -1.0), 0.0, 0.0, 0.0);
        O.VisTag      = CKP_LM_VIS_BEAM;
        return O;
    }
}
