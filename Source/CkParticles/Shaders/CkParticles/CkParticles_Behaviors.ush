// /CkParticles/CkParticles_Behaviors.ush — behavior registry + dispatch.
//
// To add a behavior: author /CkParticles/Behaviors/Behavior_<Name>.ush, #include it below, add a branch here,
// and mirror the exact math in NDICkParticlesLocal::ExecuteStage_CPU (CkParticles_DataInterface.cpp).
// The GPU (this file) and CPU mirror MUST stay in lockstep.
#pragma once
#include "/CkParticles/Common.ush"
#include "/CkParticles/Behaviors/Behavior_Gravity.ush"
#include "/CkParticles/Behaviors/Behavior_Swirl.ush"
#include "/CkParticles/Behaviors/Behavior_Explosion.ush"
#include "/CkParticles/Behaviors/Behavior_Fire.ush"
#include "/CkParticles/Behaviors/Behavior_Fireworks.ush"
#include "/CkParticles/Behaviors/Behavior_Galaxy.ush"
#include "/CkParticles/Behaviors/Behavior_Beam.ush"
#include "/CkParticles/Behaviors/Behavior_Slash.ush"
#include "/CkParticles/Behaviors/Behavior_Nova.ush"
#include "/CkParticles/Behaviors/Behavior_MuzzleFlash.ush"
#include "/CkParticles/Behaviors/Behavior_ImpactBurst.ush"
#include "/CkParticles/Behaviors/Behavior_Tracer.ush"
#include "/CkParticles/Behaviors/Behavior_SmokePlume.ush"
#include "/CkParticles/Behaviors/Behavior_SparksBurst.ush"
#include "/CkParticles/Behaviors/Behavior_GroundRing.ush"
#include "/CkParticles/Behaviors/Behavior_LightningStrike.ush"
#include "/CkParticles/Behaviors/Behavior_AuraSwirl.ush"
#include "/CkParticles/Behaviors/Behavior_LightningRange.ush"
#include "/CkParticles/Behaviors/Behavior_GunshotProjectile.ush"
#include "/CkParticles/Behaviors/Behavior_ArrowProjectile.ush"

FCkParticles_StageOutput CkParticles_ExecuteStage(FCkParticles_StageInput In)
{
    if (In.BehaviorId == 1) { return CkParticles_Behavior_Swirl(In); }
    if (In.BehaviorId == 2) { return CkParticles_Behavior_Explosion(In); }
    if (In.BehaviorId == 3) { return CkParticles_Behavior_Fire(In); }
    if (In.BehaviorId == 4) { return CkParticles_Behavior_Fireworks(In); }
    if (In.BehaviorId == 5) { return CkParticles_Behavior_Galaxy(In); }
    if (In.BehaviorId == 6) { return CkParticles_Behavior_Beam(In); }
    if (In.BehaviorId == 7) { return CkParticles_Behavior_Slash(In); }
    if (In.BehaviorId == 8) { return CkParticles_Behavior_Nova(In); }
    if (In.BehaviorId == 9) { return CkParticles_Behavior_MuzzleFlash(In); }
    if (In.BehaviorId == 10) { return CkParticles_Behavior_ImpactBurst(In); }
    if (In.BehaviorId == 11) { return CkParticles_Behavior_Tracer(In); }
    if (In.BehaviorId == 12) { return CkParticles_Behavior_SmokePlume(In); }
    if (In.BehaviorId == 13) { return CkParticles_Behavior_SparksBurst(In); }
    if (In.BehaviorId == 14) { return CkParticles_Behavior_GroundRing(In); }
    if (In.BehaviorId == 15) { return CkParticles_Behavior_LightningStrike(In); }
    if (In.BehaviorId == 16) { return CkParticles_Behavior_AuraSwirl(In); }
    if (In.BehaviorId == 17) { return CkParticles_Behavior_LightningRange(In); }
    if (In.BehaviorId == 18) { return CkParticles_Behavior_GunshotProjectile(In); }
    if (In.BehaviorId == 19) { return CkParticles_Behavior_ArrowProjectile(In); }

    // BehaviorId 0 (and any unknown id) -> Gravity.
    return CkParticles_Behavior_Gravity(In);
}
