// Standalone material look; callers supply the 16x2 RGBA16F LUT. Entity outlines use CkUsfRenderer.
// row 0 = outline RGB * brightness, type (Normal / SeeThrough / MaskedSeeThrough);
// row 1 = fill RGB, opacity. StencilMin..StencilMax index its columns.
// Keep this look at SceneColorAfterDOF: custom stencil is jittered, so temporal AA must
// resolve the outline together with the scene. Output remains scene-referred linear.
#pragma once
#include "/CkUsf/Common.ush"

#define CKUSF_OUTLINE_LUT_W 16.0
#define CKUSF_OUTLINE_LUT_H 2.0
// Limit of this standalone material's local kernel, not the native entity-outline renderer.
#define CKUSF_OUTLINE_MAX_THICKNESS 16.0

// Preserve the look's authored corner metric: box dilation for square corners,
// Euclidean dilation for rounded corners. Both search the entire footprint.
#ifndef CKUSF_OUTLINE_SQUARE_CORNERS
#define CKUSF_OUTLINE_SQUARE_CORNERS 0
#endif

FCkUsf_SurfaceOutput CkUsf_PP_SolidOutline(
    FCkUsf_SurfaceInput In,
    Texture2D OutlineParams, SamplerState OutlineParamsSampler,
    float GlobalThickness, float StencilMin, float StencilMax)
{
    FCkUsf_SurfaceOutput O = CkUsf_DefaultSurface();
    O.EmissiveColor = In.SceneColor.rgb;
    O.Opacity = 1.0;

    // Fail closed even if a hand-authored MID bypasses the subsystem's validation.
    if (!(GlobalThickness >= 1.0 && GlobalThickness <= CKUSF_OUTLINE_MAX_THICKNESS))
    { return O; }

    // Snap to stencil texel centers, in the current view rect rather than the entire
    // backing buffer. Neighbour taps must never see another editor/split-screen view.
    float2 texel = CkUsf_BufferTexelSize();
    float2 pixel = floor(CkUsf_ViewportUVToBufferUV(In.UV) / texel);
    float2 bufferUV = (pixel + 0.5) * texel;
    float sC = round(SceneTextureLookup(bufferUV, PPI_CustomStencil, false).r);
    bool centerMarked = (sC >= StencilMin && sC <= StencilMax);

    if (centerMarked)
    {
        float u = (sC - StencilMin + 0.5) / CKUSF_OUTLINE_LUT_W;
        float4 P0 = Texture2DSampleLevel(OutlineParams, OutlineParamsSampler,
            float2(u, 0.5 / CKUSF_OUTLINE_LUT_H), 0.0);
        float4 P1 = Texture2DSampleLevel(OutlineParams, OutlineParamsSampler,
            float2(u, 1.5 / CKUSF_OUTLINE_LUT_H), 0.0);
        float outlineType = round(P0.a);
        if (P1.a > 0.0)
        {
            float objectDepth = SceneTextureLookup(bufferUV, PPI_CustomDepth, false).r;
            float sceneDepth = SceneTextureLookup(bufferUV, PPI_SceneDepth, false).r;
            if (outlineType > 0.5 || objectDepth <= sceneDepth + 1.0)
            {
                float opacity = saturate(P1.a);
                if (outlineType > 1.5)
                {
                    float2 px = pixel - View.ViewRectMin.xy;
                    opacity *= fmod(floor(px.x / 4.0) + floor(px.y / 4.0), 2.0);
                }
                O.EmissiveColor = lerp(O.EmissiveColor, P1.rgb, opacity);
            }
        }
        return O;
    }

    float thickness = GlobalThickness;
    float nearestDistance = thickness + 0.5;
    float nearestCenterDistanceSq = 1e30;
    float nearestStencil = StencilMax + 1.0;
    float nearestObjectDepth = 1e30;
    float3 outlineColor = 0.0;

    // Distance is to the occupied texel's boundary (half a texel from its center).
    // Visiting EVERY texel within reach keeps even a one-pixel limb connected to its
    // ring. Fixed-radius directional probes can jump over it and draw detached copies.
    // Restrict the validated footprint to this view.
    float2 viewMin = View.ViewRectMin.xy;
    float2 viewMax = viewMin + View.ViewSizeAndInvSize.xy - 1.0;
    int2 minOffset = int2(max(-ceil(thickness), viewMin - pixel));
    int2 maxOffset = int2(min(ceil(thickness), viewMax - pixel));
    [loop]
    for (int y = minOffset.y; y <= maxOffset.y; ++y)
    {
        [loop]
        for (int x = minOffset.x; x <= maxOffset.x; ++x)
        {
            float2 offset = float2(x, y);
            float2 boundaryDistance = max(abs(offset) - 0.5, 0.0);
#if CKUSF_OUTLINE_SQUARE_CORNERS
            float distance = max(boundaryDistance.x, boundaryDistance.y);
#else
            float distance = length(boundaryDistance);
#endif
            float centerDistanceSq = dot(offset, offset);
            if (distance > nearestDistance || distance >= thickness + 0.5 ||
                (distance == nearestDistance && centerDistanceSq > nearestCenterDistanceSq))
            { continue; }

            float2 neighborUV = (pixel + offset + 0.5) * texel;
            float stencil = round(SceneTextureLookup(neighborUV, PPI_CustomStencil, false).r);
            if (stencil < StencilMin || stencil > StencilMax)
            { continue; }
            float u = (stencil - StencilMin + 0.5) / CKUSF_OUTLINE_LUT_W;
            float4 P0 = Texture2DSampleLevel(OutlineParams, OutlineParamsSampler,
                float2(u, 0.5 / CKUSF_OUTLINE_LUT_H), 0.0);
            float objectDepth = SceneTextureLookup(neighborUV, PPI_CustomDepth, false).r;
            float sceneDepth = SceneTextureLookup(neighborUV, PPI_SceneDepth, false).r;
            // Reject occluded Normal candidates before choosing the nearest source;
            // otherwise a hidden neighbor can erase a visible outline behind it.
            if (round(P0.a) < 0.5 && objectDepth > sceneDepth + 1.0)
            { continue; }
            // Equidistant overlapping rings favor the nearer surface, then a stable slot.
            if (distance == nearestDistance && centerDistanceSq == nearestCenterDistanceSq &&
                (objectDepth > nearestObjectDepth ||
                (objectDepth == nearestObjectDepth && stencil >= nearestStencil)))
            { continue; }

            nearestDistance = distance;
            nearestCenterDistanceSq = centerDistanceSq;
            nearestStencil = stencil;
            nearestObjectDepth = objectDepth;
            outlineColor = P0.rgb;
        }
    }

    // One-texel outer-edge coverage, not a blur of the whole band. Integer widths
    // give fully opaque straight bands; fractional widths only soften the last pixel.
    float coverage = saturate(thickness + 0.5 - nearestDistance);
    O.EmissiveColor = lerp(O.EmissiveColor, outlineColor, coverage);
    return O;
}
