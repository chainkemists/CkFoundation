// /CkUsf/Looks/CelShade.ush
// PostProcess cel shading: quantized lighting bands with halftone band transitions, plus separate
// treatments for sky / metal / specular / rim and a screen-space ink outline. Placed at
// SceneColorAfterDOF (see the asset's _BlendableLocation) because it reads Custom Stencil, which is
// rendered with the TAA-jittered projection — thresholding that mask after tonemapping shimmers on a
// stationary camera. Consequence: the input is scene-referred LINEAR, not display-referred.
//
// ILLUMINATION IS RECONSTRUCTED, NOT READ. A material blendable cannot see deferred lighting, so the
// lit component is approximated as SceneColor / max(BaseColor, MinimumAlbedo): for a diffuse dielectric
// that quotient is the incoming light, which is what the bands are supposed to follow. It fails exactly
// where albedo is not the whole story — metals (own group, Metallic* below), unlit/emissive pixels
// (AffectUnlit) and the sky (own group, and it has no GBuffer albedo at all, so it bands SceneColor
// luminance directly). `QuantizeFinalColor` switches the whole look to banding SceneColor luminance
// instead, which is the fallback if the reconstruction reads as albedo-driven rather than light-driven.
//
// MIDPOINT IS THE EXPOSURE ANCHOR. Pre-tonemap illumination is unbounded, so a fixed 0..1 band ramp
// would be meaningless. Midpoint is the illumination that lands mid-ramp, and 2*Midpoint is what the
// TOP band resolves to — so it sets band positions AND the brightness of the extreme bands. It is not a
// neutral reparameterization: raising it darkens the lit side while spreading the bands. Distribution,
// by contrast, is inverted exactly on the way out and only moves positions. Units are the scene's own
// PRE-EXPOSURE linear values at this chain location, so a project that changes exposure or unit scale
// retunes Midpoint, not the band count.
//
// STRENGTH GOVERNS BANDS AND PATTERN ONLY. The outline, the stepped specular and the rim are separate
// features with their own opacity/intensity controls (this look inherits the source feature's per-group
// strengths rather than one global style weight), so Strength at 0 still draws ink lines. The whole-look
// passthrough is the subsystem's Enabled, not Strength.
//
// STENCIL CONTRACT (direct value, no allocation — mirrored by ECk_Usf_CelPattern and by
// UCkUsf_CelShadeSubsystem's range validation):
//   CustomStencil == StencilBase - 1        -> transitions SUPPRESSED on that object
//   CustomStencil in [StencilBase, +9]      -> that object forces pattern (Stencil - StencilBase)
//   anything else                           -> the global Pattern
// Requires r.CustomDepth 3 (Custom Depth-Stencil WITH stencil) and RenderCustomDepth on the mesh.
//
// THE EFFECT MASK IS A SECOND, INDEPENDENT CLAIM ON THE SAME BYTE. MaskMode / MaskStencilMin /
// MaskStencilMax gate the WHOLE look per pixel (see CkUsf_Stylize_MaskWeight in StylizeCommon.ush); the
// subsystem rejects a mask range that intersects either the pattern span above or the outline
// subsystem's, because all three read one 8-bit value and an overlap restyles the wrong meshes with
// nothing naming the cause. Masked-out pixels are the untouched scene colour exactly, not an
// approximation of it — the mask is the last thing applied, after the ink outline.
//
// BAND PLACEMENT HAS TWO MODES (ECk_Usf_CelDistribution). Exponent is the historical one: N bands of
// EQUAL ramp width with `Distribution` biasing where that spacing sits — one exponent moves every
// boundary together, so it cannot express "two narrow bands in the shadows, one wide one above".
// CustomEdges hands the boundaries over directly: BandEdge0..7 (ascending, 0..1) with BandEdgeCount live
// entries, and the bands are the intervals BETWEEN them, so N edges make N+1 bands and `Bands` is
// ignored. `Distribution` is forced to 1 there — the edges already ARE the placement, and shaping the
// ramp underneath them would move the boundaries the artist just authored.
//
// CustomEdges OVERRIDES THE PER-GROUP BAND COUNTS TOO. The sky and metal groups swap `Bands` for
// `SkyBands` / `MetallicBands` in Exponent mode; in CustomEdges the edge list is the placement for
// EVERY group, so those two counts stop having any effect. That is deliberate, not an oversight: a
// per-group edge list would be three more 8-slot parameter blocks (24 more pins on an already
// 84-input node) to express something no shipped preset asks for. Authored band placement is a
// property of the LOOK here, not of the group. The groups keep their own strengths and pattern
// strengths, which is what actually distinguishes them.
//
// NOT IMPLEMENTED, ON PURPOSE: temporal stabilization of world-space patterns on translating meshes.
// It needs a frame history a blendable does not have; DebugMode 8 (MotionOffset) therefore reports
// black rather than pretending to measure something.
#pragma once
#include "/CkUsf/Common.ush"
#include "/CkUsf/StylizeCommon.ush"

// --------------------------------------------------------------------------------------------------------------------

// A GBuffer albedo this dark means the pixel carries no diffuse response at all (unlit / emissive /
// sky), so the illumination quotient there is noise divided by noise rather than a lighting term.
#define CKUSF_CEL_UNLIT_ALBEDO_EPS 1e-3

// World distance (uu) at which the world-space pattern runs at its authored cell size. Octaves are
// counted from here, so a subject standing at roughly this range keeps the size the artist tuned.
// In.WorldPosition arrives as float32, so cell coordinates lose sub-cell precision past roughly 1e6 uu
// from the origin — a world-space pattern on far-from-origin geometry quantizes and then stops moving.
#ifndef CKUSF_CEL_OCTAVE_REF_DISTANCE
#define CKUSF_CEL_OCTAVE_REF_DISTANCE 500.0
#endif

// Steepest slope any halftone primitive in StylizeCommon.ush reaches per pattern cell. The triangle-wave
// and dot families are exactly 2 (they cross 0..1 over half a cell); Triangles is the one outlier at 3.
// It converts a footprint measured in CELLS into one measured in THRESHOLD units, which is what the
// band comparison below needs to anti-alias itself.
#ifndef CKUSF_CEL_HALFTONE_SLOPE
#define CKUSF_CEL_HALFTONE_SLOPE 2.0
#endif

// --------------------------------------------------------------------------------------------------------------------
// Neighbour taps. Each scene texture carries its OWN viewport rect, so a viewport UV has to be mapped
// through that texture's own transform — the house CkUsf_ViewportUVToBufferUV maps to the scene buffer
// only, which silently drifts under screen percentage / dynamic resolution for any other input.
// --------------------------------------------------------------------------------------------------------------------

float CkUsf_CelShade_TapDepth(float2 ViewportUV)
{
    float2 UV = ClampSceneTextureUV(
        ViewportUVToSceneTextureUV(saturate(ViewportUV), PPI_SceneDepth), PPI_SceneDepth);
    return SceneTextureLookup(UV, PPI_SceneDepth, false).r;
}

float3 CkUsf_CelShade_TapNormal(float2 ViewportUV)
{
    float2 UV = ClampSceneTextureUV(
        ViewportUVToSceneTextureUV(saturate(ViewportUV), PPI_WorldNormal), PPI_WorldNormal);
    return SceneTextureLookup(UV, PPI_WorldNormal, false).rgb;
}

float3 CkUsf_CelShade_TapAlbedo(float2 ViewportUV)
{
    float2 UV = ClampSceneTextureUV(
        ViewportUVToSceneTextureUV(saturate(ViewportUV), PPI_BaseColor), PPI_BaseColor);
    return SceneTextureLookup(UV, PPI_BaseColor, false).rgb;
}

// --------------------------------------------------------------------------------------------------------------------
// Edge masks. A hard step() on a measure that hovers AT its threshold flips per pixel, so a MARGINAL
// edge — a shallow crease on curved armour is the canonical one — renders as a dotted line instead of
// either a line or nothing. Smoothing across the measure's own per-pixel footprint leaves the authored
// threshold's meaning untouched (it is still the 50% crossing, so every preset keeps its tuning) and
// turns the stipple into a continuous line whose ends fade out. Where the measure is far above the
// threshold — a real silhouette in the depth channel — the footprint scales with it and the mask still
// resolves to a solid 1.
// --------------------------------------------------------------------------------------------------------------------

float CkUsf_CelShade_EdgeMask(float Measure, float Threshold)
{
    float Width = max(fwidth(Measure) * 0.5, 1e-4);
    return smoothstep(Threshold - Width, Threshold + Width, Measure);
}

// --------------------------------------------------------------------------------------------------------------------
// Band ramp.
// --------------------------------------------------------------------------------------------------------------------

// Source luminance -> 0..1 ramp position. Midpoint maps to 0.5 (it is the exposure anchor described at
// the top of this file); Distribution then biases where the bands sit without moving that anchor.
float CkUsf_CelShade_Shape(float Value, float Midpoint, float Distribution)
{
    float V = saturate(Value / max(Midpoint * 2.0, 1e-4));
    return pow(V, max(Distribution, 1e-3));
}

float CkUsf_CelShade_Unshape(float Ramp, float Midpoint, float Distribution)
{
    return pow(saturate(Ramp), 1.0 / max(Distribution, 1e-3)) * max(Midpoint * 2.0, 1e-4);
}

// Ramp value of one band. ShadowLift raises the DARKEST band only — the top band always resolves to 1,
// so lifting the shadows never dims the lit side.
float CkUsf_CelShade_LevelAt(float Index, float Bands, float ShadowLift)
{
    float N = max(Bands, 2.0);
    float T = saturate(Index / (N - 1.0));
    return lerp(saturate(ShadowLift), 1.0, T);
}

// --------------------------------------------------------------------------------------------------------------------

FCkUsf_SurfaceOutput CkUsf_PP_CelShade(
    FCkUsf_SurfaceInput In,
    float Bands,
    float Midpoint,
    float BandOffset,
    float Distribution,
    float BandSoftness,
    float ShadowLift,
    float Strength,
    float QuantizeFinalColor,
    float EnablePattern,
    float Pattern,
    float PatternSpace,
    float PatternStrength,
    float PatternContrast,
    float PatternWorldSize,
    float PatternPixelSize,
    float TriplanarSharpness,
    float PatternDistanceScaling,
    float PatternOctaveMin,
    float PatternOctaveMax,
    float PatternScrollSpeed,
    float Saturation,
    float MinimumAlbedo,
    float AffectUnlit,
    float EnableSky,
    float SkyDistance,
    float SkyBands,
    float SkyStrength,
    float SkyPattern,
    float SkyPatternStrength,
    float SkyPatternScale,
    float MetallicThreshold,
    float MetallicBands,
    float MetallicStrength,
    float MetallicPatternStrength,
    float EnableSpecular,
    float SpecularSteps,
    float SpecularThreshold,
    float SpecularIntensity,
    float SpecularRoughnessCutoff,
    float EnableRimLight,
    float RimPower,
    float RimThreshold,
    float RimSoftness,
    float RimIntensity,
    float RimFollowsLighting,
    float EnableOutline,
    float OutlineThickness,
    float OutlineQuality,
    float OutlineOpacity,
    float OutlineBlendMode,
    float OutlineDepthThreshold,
    float OutlineNormalThreshold,
    float OutlineAlbedoThreshold,
    float OutlineDistanceFade,
    float EnableStencilPatterns,
    float StencilBase,
    float DebugMode,
    float DistributionMode,
    float BandEdgeCount,
    float BandEdge0,
    float BandEdge1,
    float BandEdge2,
    float BandEdge3,
    float BandEdge4,
    float BandEdge5,
    float BandEdge6,
    float BandEdge7,
    float MaskMode,
    float MaskStencilMin,
    float MaskStencilMax,
    float3 ShadowTint,
    float3 LightTint,
    float3 RimColor,
    float3 OutlineColor)
{
    FCkUsf_SurfaceOutput O = CkUsf_DefaultSurface();

    float2 ViewportUV = In.UV;
    float3 Scene      = In.SceneColor.rgb;
    float3 Albedo     = In.SceneBaseColor.rgb;
    float3 Normal     = normalize(In.SceneNormal.rgb + float3(0.0, 0.0, 1e-6));
    float  Depth      = In.SceneDepth.r;
    float  Metallic   = In.SceneMetallic.r;
    float  Roughness  = In.SceneRoughness.r;
    float  Stencil    = round(In.CustomStencil.r);

    // ---- Group selection ---------------------------------------------------------------------------
    // Sky first: it has no GBuffer albedo, so it must never reach the illumination quotient.
    bool IsSky   = (EnableSky > 0.5) && (Depth >= max(SkyDistance, 1.0));
    bool IsMetal = (!IsSky) && (Metallic >= saturate(MetallicThreshold));
    bool IsUnlit = max(Albedo.r, max(Albedo.g, Albedo.b)) < CKUSF_CEL_UNLIT_ALBEDO_EPS;

    float3 Illumination = Scene / max(Albedo, max(MinimumAlbedo, 1e-3));
    float  IlluminationLuma = CkUsf_Stylize_Luminance(Illumination);
    float  SceneLuma = CkUsf_Stylize_Luminance(Scene);

    // The sky and the final-colour mode both band SceneColor luminance rather than the reconstruction:
    // the sky because it has no albedo to divide by, the mode because that is its whole point.
    bool BandsFinalColor = IsSky || (QuantizeFinalColor > 0.5);
    float SourceLuma = BandsFinalColor ? SceneLuma : IlluminationLuma;

    float GroupBands = Bands;
    float GroupStrength = Strength;
    float GroupPatternStrength = PatternStrength;
    float GroupPatternScale = 1.0;
    int   GroupPattern = (int)(Pattern + 0.5);

    if (IsSky)
    {
        GroupBands = SkyBands;
        GroupStrength = SkyStrength;
        GroupPatternStrength = SkyPatternStrength;
        GroupPatternScale = max(SkyPatternScale, 1e-3);
        GroupPattern = (int)(SkyPattern + 0.5);
    }
    else if (IsMetal)
    {
        GroupBands = MetallicBands;
        GroupStrength = MetallicStrength;
        GroupPatternStrength = MetallicPatternStrength;
    }

    // ---- Per-object stencil ------------------------------------------------------------------------
    bool StencilActive = EnableStencilPatterns > 0.5;
    float StencilLow = round(StencilBase) - 1.0;
    bool StencilSuppresses = StencilActive && (Stencil == StencilLow);
    bool StencilSelects = StencilActive && (Stencil >= round(StencilBase)) && (Stencil <= round(StencilBase) + 9.0);

    if (StencilSelects)
    { GroupPattern = (int)(Stencil - round(StencilBase)); }

    float EffectivePatternStrength = StencilSuppresses
        ? 0.0
        : (EnablePattern > 0.5 ? saturate(GroupPatternStrength) : 0.0);

    // ---- Pattern threshold -------------------------------------------------------------------------
    // World space attaches the pattern to the surface (it holds still under camera motion but SLIDES on
    // translating meshes — the source's stabilization for that needs a frame history a blendable has
    // not got); screen space is camera-aligned and always stable.
    float2 PatternCoord;
    float  PatternThreshold;
    float3 PatternWorldCell = 0.0;

    if (PatternSpace < 0.5)
    {
        // The distance-driven target is a WHOLE octave — a continuously scaled cell size gives every
        // distance its own sub-cell phase and the pattern swims as the camera dollies. PatternDistanceScaling
        // is how far the cell is taken toward that target, so only 1.0 lands exactly on it; intermediate
        // values are a deliberate compromise between constant screen density and a stable lattice.
        float Octave = clamp(log2(max(Depth, 1.0) / CKUSF_CEL_OCTAVE_REF_DISTANCE),
            min(PatternOctaveMin, PatternOctaveMax), max(PatternOctaveMin, PatternOctaveMax));
        float OctaveScale = lerp(1.0, exp2(floor(Octave)), saturate(PatternDistanceScaling));

        float CellSize = max(PatternWorldSize, 1e-3) * OctaveScale * GroupPatternScale;
        float3 P = (In.WorldPosition + In.Time * PatternScrollSpeed) / CellSize;

        float3 Weights = pow(abs(Normal), max(TriplanarSharpness, 1e-3));
        Weights /= max(Weights.x + Weights.y + Weights.z, 1e-4);

        // The three planar patterns are blended, not the coordinates: blending coordinates across a
        // corner produces a smeared cell that belongs to no plane.
        PatternThreshold =
            Weights.x * CkUsf_Stylize_HalftonePattern(GroupPattern, P.yz, PatternContrast) +
            Weights.y * CkUsf_Stylize_HalftonePattern(GroupPattern, P.zx, PatternContrast) +
            Weights.z * CkUsf_Stylize_HalftonePattern(GroupPattern, P.xy, PatternContrast);

        PatternCoord = P.xy;
        PatternWorldCell = P;
    }
    else
    {
        float2 ViewSize = GetSceneTextureViewSize(PPI_PostProcessInput0).xy;
        PatternCoord = (ViewportUV * ViewSize + In.Time * PatternScrollSpeed)
            / max(PatternPixelSize * GroupPatternScale, 1e-3);
        PatternThreshold = CkUsf_Stylize_HalftonePattern(GroupPattern, PatternCoord, PatternContrast);
    }

    // Screen footprint of ONE pattern cell, taken at top level so the derivatives are never inside a
    // branch. It comes from the pattern COORDINATE, whose derivative is smooth, and never from the
    // threshold VALUE, which is periodic and would blow the footprint up at every cell seam. The world
    // path measures the full 3D cell coordinate because the threshold is a triplanar blend of all three
    // planar projections, so any one of them can be the steepest.
    float PatternCellFootprint = PatternSpace < 0.5
        ? length(fwidth(PatternWorldCell))
        : length(fwidth(PatternCoord));

    // ---- Band quantization -------------------------------------------------------------------------
    // CustomEdges places the boundaries itself, so the ramp underneath them must NOT also be shaped —
    // an exponent there would move every authored edge by a different amount.
    bool UsesCustomEdges = DistributionMode > 0.5;
    float EffectiveDistribution = UsesCustomEdges ? 1.0 : Distribution;

    float Ramp = CkUsf_CelShade_Shape(SourceLuma, Midpoint, EffectiveDistribution);

    float BandCount;
    float BandIndex;
    float BandFraction;

    if (UsesCustomEdges)
    {
        float Edges[8] = { BandEdge0, BandEdge1, BandEdge2, BandEdge3,
                           BandEdge4, BandEdge5, BandEdge6, BandEdge7 };
        int EdgeCount = clamp((int)(BandEdgeCount + 0.5), 1, 8);

        BandCount = (float)EdgeCount + 1.0;

        // BandOffset keeps meaning "slide every boundary by a fraction of a band", which in the
        // exponent path is exactly what adding it to Ramp * BandCount does.
        float Shifted = Ramp + BandOffset / BandCount;

        // Counting the edges STRICTLY below the ramp gives the band ordinal directly. It relies on the
        // list being ASCENDING, which the subsystem is what enforces — a non-ascending list is
        // rejected there rather than producing monotonic-looking nonsense here.
        //
        // Strictly-below, not at-or-below, so the count is bounded by EdgeCount even when the unused
        // filler slots are read: the subsystem writes 1.0 into every slot past the count, and a ramp of
        // exactly 1.0 would then be counted as "at" each of them. The `e < EdgeCount` guard already
        // excludes those slots, so this is belt-and-braces — but it is what makes the filler VALUE
        // genuinely inert rather than inert-because-of-one-guard.
        float Index = 0.0;
        [unroll]
        for (int e = 0; e < 8; ++e)
        {
            if (e < EdgeCount && Shifted > saturate(Edges[e]))
            { Index += 1.0; }
        }

        // The band spans [Edges[Index-1], Edges[Index]], with the ramp's own 0 and 1 standing in for
        // the two missing outer edges.
        float Low = 0.0;
        float High = 1.0;
        [unroll]
        for (int f = 0; f < 8; ++f)
        {
            if (f >= EdgeCount)
            { continue; }

            if ((float)f == Index - 1.0) { Low = saturate(Edges[f]); }
            if ((float)f == Index)       { High = saturate(Edges[f]); }
        }

        BandIndex = Index;
        BandFraction = saturate((Shifted - Low) / max(High - Low, 1e-4));
    }
    else
    {
        BandCount = max(GroupBands, 2.0);
        float BandPosition = Ramp * BandCount + BandOffset;
        BandIndex = clamp(floor(BandPosition), 0.0, BandCount - 1.0);
        BandFraction = saturate(BandPosition - floor(BandPosition));
    }

    float LevelLow = CkUsf_CelShade_LevelAt(BandIndex, BandCount, ShadowLift);
    float LevelHigh = CkUsf_CelShade_LevelAt(min(BandIndex + 1.0, BandCount - 1.0), BandCount, ShadowLift);

    // The halftone IS the quantizer: comparing the within-band fraction against the pattern threshold
    // makes the transition between two bands a growing dot/line field instead of a hard edge. Softness
    // is the pattern-free alternative for the same boundary, so the two are blended by pattern strength
    // rather than added.
    float SoftTransition = BandSoftness > 1e-4
        ? smoothstep(saturate(1.0 - BandSoftness), 1.0, BandFraction)
        : 0.0;
    // Anti-aliased against the pattern's own screen footprint. A bare threshold makes every dot edge a
    // binary one-pixel boundary: it aliases into moire wherever a cell approaches pixel size (distant
    // ground planes past the octave ceiling), and the world lattice re-anchors by the TAA jitter every
    // frame, so those edges crawl under camera motion even on a static wall. Contrast steepens the
    // primitive's slope, so it widens the footprint by the same factor. Past a footprint of ~1 the
    // comparison resolves to its average, which is the correct limit for a pattern below pixel size.
    float PatternEdgeWidth = max(
        PatternCellFootprint * CKUSF_CEL_HALFTONE_SLOPE * max(PatternContrast, 1e-3), 1e-4);
    float PatternTransition = smoothstep(
        -PatternEdgeWidth, PatternEdgeWidth, BandFraction - PatternThreshold);
    float Transition = lerp(SoftTransition, PatternTransition, EffectivePatternStrength);

    float Level = lerp(LevelLow, LevelHigh, Transition);

    // ---- Apply -------------------------------------------------------------------------------------
    // Scaling the scene colour by the banded/original luminance ratio bands the LIGHT while leaving
    // albedo and hue untouched; replacing the colour outright would flatten every material to one tint.
    float BandedSource = CkUsf_CelShade_Unshape(Level, Midpoint, EffectiveDistribution);
    float3 Cel = Scene * (BandedSource / max(SourceLuma, 1e-3));

    Cel *= lerp(ShadowTint, LightTint, Level);

    Cel = CkUsf_Stylize_ApplySaturation(Cel, Saturation);

    // ---- Stepped specular --------------------------------------------------------------------------
    if (EnableSpecular > 0.5 && !IsSky && Roughness <= saturate(SpecularRoughnessCutoff))
    {
        float Steps = max(SpecularSteps, 1.0);
        float Highlight = saturate((Ramp - saturate(SpecularThreshold)) /
            max(1.0 - saturate(SpecularThreshold), 1e-3));
        float SpecularMask = floor(Highlight * Steps) / Steps;
        Cel += LightTint * (SpecularMask * max(SpecularIntensity, 0.0));
    }

    // ---- Rim light ---------------------------------------------------------------------------------
    // The view vector comes from the screen rect rather than a camera position: the engine helper is
    // orthographic-safe and needs no large-world-coordinate arithmetic, whereas differencing
    // In.WorldPosition against a camera origin does.
    if (EnableRimLight > 0.5 && !IsSky)
    {
        float2 ScreenPosition = ViewportUV * float2(2.0, -2.0) + float2(-1.0, 1.0);
        float3 ToPixel = normalize(ScreenVectorFromScreenRect(float4(ScreenPosition, 1.0, 0.0)));
        float NdotV = saturate(dot(Normal, -ToPixel));

        float Facing = pow(saturate(1.0 - NdotV), max(RimPower, 1e-3));
        float RimMask = smoothstep(saturate(RimThreshold),
            saturate(RimThreshold) + max(RimSoftness, 1e-3), Facing);

        // Following the lighting keeps the rim off surfaces that are in shadow, which is what stops it
        // reading as a uniform outline glow.
        RimMask *= lerp(1.0, Level, saturate(RimFollowsLighting));
        Cel += RimColor * (RimMask * max(RimIntensity, 0.0));
    }

    float3 Result = lerp(Scene, Cel, saturate(GroupStrength));

    // Unlit pixels have no diffuse response to band. Sky is exempt because its own group already
    // handles it through SceneColor luminance.
    if (AffectUnlit < 0.5 && IsUnlit && !IsSky)
    { Result = Scene; }

    // ---- Outline -----------------------------------------------------------------------------------
    float Edge = 0.0;
    if (EnableOutline > 0.5)
    {
        // Same viewport the pattern path measures in (PostProcessInput0's), so "thickness in pixels" means
        // one thing across the whole look. Equal to the scene buffer's at this chain location today; the
        // offsets are viewport UVs and each tap maps them through its own texture's rect anyway.
        float2 ViewSize = GetSceneTextureViewSize(PPI_PostProcessInput0).xy;
        float2 Texel = max(OutlineThickness, 1.0) / max(ViewSize, 1.0);

        // Quality is a tap count, not a radius: 4 taps are enough for the Laplacian, the extra 4
        // diagonals only matter on edges that run diagonally through the pixel.
        const float2 Offsets[8] =
        {
            float2( 1.0,  0.0), float2(-1.0,  0.0), float2( 0.0,  1.0), float2( 0.0, -1.0),
            float2( 0.70711,  0.70711), float2(-0.70711,  0.70711),
            float2( 0.70711, -0.70711), float2(-0.70711, -0.70711)
        };
        int TapCount = OutlineQuality > 0.5 ? 8 : 4;

        float DepthSum = 0.0;
        float NormalEdge = 0.0;
        float AlbedoEdge = 0.0;

        [unroll]
        for (int i = 0; i < 8; ++i)
        {
            if (i >= TapCount)
            { continue; }

            float2 TapUV = ViewportUV + Offsets[i] * Texel;

            DepthSum += CkUsf_CelShade_TapDepth(TapUV);
            NormalEdge = max(NormalEdge,
                1.0 - saturate(dot(Normal, normalize(CkUsf_CelShade_TapNormal(TapUV) + float3(0.0, 0.0, 1e-6)))));

            float3 TapAlbedo = CkUsf_CelShade_TapAlbedo(TapUV);
            AlbedoEdge = max(AlbedoEdge, length(TapAlbedo - Albedo));
        }

        // Laplacian, not a gradient: a flat surface seen at a grazing angle has a linear depth ramp and
        // a large gradient but a near-zero second derivative, so only silhouettes and creases spike.
        // Divided by depth so the test is distance-independent.
        float DepthLaplacian = abs(DepthSum - TapCount * Depth) / max(Depth, 1.0);

        float DepthEdge = CkUsf_CelShade_EdgeMask(DepthLaplacian, max(OutlineDepthThreshold, 1e-4));
        float NormalEdgeMask = CkUsf_CelShade_EdgeMask(NormalEdge, max(OutlineNormalThreshold, 1e-4));
        float AlbedoEdgeMask = CkUsf_CelShade_EdgeMask(AlbedoEdge, max(OutlineAlbedoThreshold, 1e-4));

        float Fade = OutlineDistanceFade > 1.0 ? saturate(1.0 - Depth / OutlineDistanceFade) : 1.0;
        // max, not a saturated sum: for the binary masks this was written against the two are the same
        // value, but the masks are now soft, and summing three of them lights a full-strength line on a
        // pixel that is just UNDER all three thresholds. The strongest detector wins instead.
        Edge = max(DepthEdge, max(NormalEdgeMask, AlbedoEdgeMask)) * saturate(OutlineOpacity) * Fade;

        int BlendMode = (int)(OutlineBlendMode + 0.5);
        if (BlendMode == 1)      { Result *= lerp(float3(1.0, 1.0, 1.0), OutlineColor, Edge); }
        else if (BlendMode == 2) { Result += OutlineColor * Edge; }
        else                     { Result = lerp(Result, OutlineColor, Edge); }
    }

    // ---- Effect mask -------------------------------------------------------------------------------
    // LAST, so a masked-out pixel is the untouched scene colour exactly — bands, pattern, specular, rim
    // and the ink outline all sit inside what the mask gates.
    float MaskWeight = CkUsf_Stylize_MaskWeight(
        (int)(MaskMode + 0.5), Stencil, MaskStencilMin, MaskStencilMax);
    Result = lerp(Scene, Result, MaskWeight);

    // ---- Debug -------------------------------------------------------------------------------------
    int Debug = (int)(DebugMode + 0.5);
    if (Debug == 1)
    {
        float Normalized = BandIndex / max(BandCount - 1.0, 1.0);
        Result = float3(Normalized, Normalized, Normalized);
    }
    else if (Debug == 2) { Result = float3(Edge, Edge, Edge); }
    else if (Debug == 3) { Result = Illumination; }
    else if (Debug == 4) { Result = Albedo; }
    else if (Debug == 5) { Result = Normal * 0.5 + 0.5; }
    else if (Debug == 6) { Result = float3(PatternThreshold, PatternThreshold, PatternThreshold); }
    else if (Debug == 7) { Result = float3(frac(PatternCoord), 0.0); }
    else if (Debug == 8) { Result = float3(0.0, 0.0, 0.0); }
    else if (Debug == 9)
    {
        float Slot = saturate((Stencil - StencilLow) / 11.0);
        Result = StencilSuppresses || StencilSelects ? float3(0.0, Slot, 1.0 - Slot) : float3(0.0, 0.0, 0.0);
    }
    else if (Debug == 10) { Result = float3(MaskWeight, MaskWeight, MaskWeight); }

    O.EmissiveColor = Result;
    O.Opacity = 1.0;
    return O;
}
