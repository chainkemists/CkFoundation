// /CkUsf/Looks/FbmWarp.ush
#pragma once
#include "/CkUsf/Common.ush"

// Params: ColorLow (Vector), ColorHigh (Vector), Speed (Scalar), then Time, UV.
// Domain-warped fractal noise (Inigo Quilez style): fbm of fbm of fbm. Many octaves
// of value noise — swirling, cloud-like, heavy. Uses the warp magnitude to colour.
FCkUsf_SurfaceOutput CkUsf_Look_FbmWarp(float3 ColorLow, float3 ColorHigh, float Speed, float Time, float2 UV)
{
    FCkUsf_SurfaceOutput O = CkUsf_DefaultSurface();

    float2 P = (UV - 0.5) * 6.0;
    float  T = Time * Speed * 0.2;

    // First warp layer.
    float2 Q = float2(
        CkUsf_Fbm(P + float2(0.0, 0.0) + T),
        CkUsf_Fbm(P + float2(5.2, 1.3) - T));

    // Second warp layer driven by the first.
    float2 R = float2(
        CkUsf_Fbm(P + 4.0 * Q + float2(1.7, 9.2) + T * 0.5),
        CkUsf_Fbm(P + 4.0 * Q + float2(8.3, 2.8) - T * 0.5));

    float V = CkUsf_Fbm(P + 4.0 * R);

    // Colour by final value, brightened by the warp magnitude so ridges glow.
    float3 Col = lerp(ColorLow, ColorHigh, saturate(V * 1.4));
    Col = lerp(Col, ColorHigh * 1.5, saturate(length(R) * 0.5));
    O.EmissiveColor = Col * 1.6;
    O.BaseColor = float3(0.0, 0.0, 0.0);
    O.Opacity = 1.0;
    return O;
}
