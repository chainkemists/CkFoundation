// /CkUsf/Looks/PixelArt.ush
// PostProcess pixel-art stylization: 1-texel outlines, quantized bands, palette reduction.
//
// Placed at SceneColorAfterDOF (see the asset's _BlendableLocation) — RENDER resolution, pre-TAA. That is
// not a preference: an outline is only exactly one texel wide if it is computed at the resolution the
// scene was rasterized at. Run this after tonemapping and the kernel steps in DISPLAY pixels, so a
// "1-pixel" line comes out as many screen pixels wide as the upscale factor, which is the whole thing the
// pixel-art renderer exists to avoid.
//
// Pipeline, in order (the order IS the contract):
//   1. edges     — 4-tap plus kernel over depth + world normal, classified into silhouette / crease
//   2. bands     — quantize the scene colour's LIGHTNESS into N bands with a controllable transition
//                  width. The axis is Rec.601 luminance or OKLab L (ColorSpace), and WarmShift adds the
//                  reference warm/cool drift with band brightness
//   3. edge apply— either flat multipliers, or a +/-1 BAND shift applied BEFORE the palette snap
//   4. palette   — steps per channel, nearest authored entry (RGB- or OKLab-distance), or lightness steps
//
// Step 3 before step 4 is the t3ssel8r signature and the reason the two cannot be reordered: shifting a
// band and THEN snapping means an outline is always a colour the palette already contains. Tinting after
// the snap would introduce colours the artist never chose, which reads as a completely different style.
//
// This look sits pre-tonemap, so its input is scene-referred LINEAR and unbounded. Luminance is therefore
// normalized through Reinhard (L/(1+L)) before it is banded and inverted on the way out — HandDrawn's
// approach, for its reason: a 0..1 ladder applied to unbounded light would put every band boundary in the
// darks, and a plain saturate would collapse everything above 1 into the top band and render bright scenes
// flat. There is nothing to mistune here (CelShade needs its Midpoint because it places band POSITIONS
// against a scene's exposure; this only needs a monotone domain to quantize in).
#pragma once
#include "/CkUsf/Common.ush"
#include "/CkUsf/StylizeCommon.ush"

// --------------------------------------------------------------------------------------------------------------------

// Neighbour taps run in BUFFER space, converted once. Viewport UV and buffer UV differ whenever the view
// rect does not fill the scene buffer — which under this renderer is ALWAYS, because driving the screen
// percentage is how it gets a low internal resolution in the first place. Tapping at raw viewport UV
// would drift off-object by exactly the amount the renderer downscaled by.
float CkUsf_PixelArt_SampleDepth(float2 BufferUV)
{
    return SceneTextureLookup(ClampSceneTextureUV(BufferUV, PPI_SceneDepth), PPI_SceneDepth, false).r;
}

// Returned DECODED, in [-1,1] world space, so there is no 2n-1 remap to do here. Every sibling look uses
// the tap exactly this way (CelShade.ush:104, EdgeOutline.ush:48, CrossHatch.ush:98). The epsilon is not
// decoration: a sky pixel writes a zero normal, and normalize(0) is NaN.
float3 CkUsf_PixelArt_SampleNormal(float2 BufferUV)
{
    const float3 Raw = SceneTextureLookup(
        ClampSceneTextureUV(BufferUV, PPI_WorldNormal), PPI_WorldNormal, false).rgb;

    return normalize(Raw + float3(0.0, 0.0, 1e-6));
}

// --------------------------------------------------------------------------------------------------------------------

// Bands the value into Bands steps, with a transition zone of ThresholdGradientSize (0 = hard step, 1 = the
// full band width blended). The blend is what stops a slowly moving light from making a band boundary pop
// across a whole surface in one frame.
float CkUsf_PixelArt_QuantizeBands(float Value, float Bands, float TransitionSize)
{
    float BandCount = max(Bands, 2.0);
    float BandWidth = 1.0 / BandCount;

    float Index = floor(Value * BandCount);
    float Quantized = saturate(Index * BandWidth);

    if (TransitionSize <= 1e-4)
    { return Quantized; }

    // Blend across the boundary this sample is nearest to, not across the whole band: a wide transition
    // should soften the edges of the bands, never turn the ladder back into a gradient.
    float Nearest = round(Value * BandCount);
    float Threshold = Nearest * BandWidth;
    float HalfWidth = 0.5 * BandWidth * saturate(TransitionSize);

    float Blend = smoothstep(max(0.0, Threshold - HalfWidth), min(1.0, Threshold + HalfWidth), Value);

    return saturate(lerp(saturate((Nearest - 1.0) * BandWidth), saturate(Nearest * BandWidth), Blend));
}

// --------------------------------------------------------------------------------------------------------------------

FCkUsf_SurfaceOutput CkUsf_PP_PixelArt(
    FCkUsf_SurfaceInput In,
    float EnableOutline,
    float DepthThreshold,
    float AngleZCutoff,
    float AngleZScale,
    float NormalSmoothLow,
    float NormalSmoothHigh,
    float LineDarken,
    float CreaseBrighten,
    float EdgeMode,
    float Bands,
    float ThresholdGradientSize,
    float DitherStrength,
    float ColorSpace,
    float WarmShift,
    float PaletteMode,
    float PaletteCount,
    float3 PaletteColor0, float3 PaletteColor1, float3 PaletteColor2, float3 PaletteColor3,
    float3 PaletteColor4, float3 PaletteColor5, float3 PaletteColor6, float3 PaletteColor7)
{
    FCkUsf_SurfaceOutput O = CkUsf_DefaultSurface();

    const float2 ViewportUV = In.UV;
    const float2 BufferUV = CkUsf_ViewportUVToBufferUV(ViewportUV);
    const float2 Texel = CkUsf_BufferTexelSize();

    float3 Color = In.SceneColor.rgb;

    // ---- 1. Edges ---------------------------------------------------------------------------------
    // 0 = none, 1 = darken (silhouette, or the concave side of a crease), 2 = brighten (convex side).
    int EdgeKind = 0;

    if (EnableOutline > 0.5)
    {
        const float CenterDepth = CkUsf_PixelArt_SampleDepth(BufferUV);
        const float3 CenterNormal = CkUsf_PixelArt_SampleNormal(BufferUV);

        const float2 Offsets[4] = {
            float2( 0.0, -1.0),   // up
            float2(-1.0,  0.0),   // left
            float2( 1.0,  0.0),   // right
            float2( 0.0,  1.0)};  // down

        float NeighborDepth[4];
        float3 NeighborNormal[4];

        [unroll]
        for (int Tap = 0; Tap < 4; ++Tap)
        {
            const float2 TapUV = BufferUV + Offsets[Tap] * Texel;
            NeighborDepth[Tap] = CkUsf_PixelArt_SampleDepth(TapUV);
            NeighborNormal[Tap] = CkUsf_PixelArt_SampleNormal(TapUV);
        }

        // A surface seen nearly edge-on has an enormous depth gradient with no edge in it, which is what
        // grows a staircase of false outlines across a floor. Scale the threshold by how side-on the
        // surface is, so grazing geometry needs a proportionally larger step to count.
        // NOT In.CameraVector: that input is wired for SURFACE looks only and reads zero in a
        // post-process one, which would silently make every surface read as fully face-on and disable the
        // grazing-angle fix entirely. The screen-rect helper is orthographic-safe (this renderer is
        // orthographic by definition) and needs no large-world-coordinate arithmetic.
        const float2 ScreenPosition = ViewportUV * float2(2.0, -2.0) + float2(-1.0, 1.0);
        const float3 ViewDir = -normalize(ScreenVectorFromScreenRect(float4(ScreenPosition, 1.0, 0.0)));
        const float Facing = 1.0 - saturate(abs(dot(CenterNormal, ViewDir)));
        const float Grazing = saturate((Facing - AngleZCutoff) / max(1.0 - AngleZCutoff, 1e-4));
        const float DepthCutoffBase = max(DepthThreshold, 1e-5) * (Grazing * AngleZScale + 1.0);
        const float DepthCutoff = DepthCutoffBase * max(CenterDepth, 1.0);

        // One-sided on purpose: of the two texels straddling a silhouette only the NEARER one draws the
        // line, which is what keeps it one texel wide instead of two.
        float MaxDepthStep = 0.0;

        [unroll]
        for (int Silhouette = 0; Silhouette < 4; ++Silhouette)
        { MaxDepthStep = max(MaxDepthStep, NeighborDepth[Silhouette] - CenterDepth); }

        const bool IsSilhouette = MaxDepthStep > DepthCutoff;

        // Opposed-PAIR contrast rather than a sum of per-neighbour differences: a sum fires on smooth
        // curvature, where every neighbour differs a little and none of them is an edge.
        //
        // A neighbour only contributes while the surface is CONTINUOUS across to it. Comparing normals across
        // an occlusion-scale depth step manufactures a crease on the FAR side of every silhouette — a bright or
        // dark fringe hugging the outline, worst against the sky, whose stand-in normal is arbitrary. The
        // continuity cutoff is scaled by the NEARER of the two depths so a distant background (or the sky's
        // enormous depth) can never inflate its own gate.
        float NeighborContrast[4];

        [unroll]
        for (int Neighbor = 0; Neighbor < 4; ++Neighbor)
        {
            const float ContinuityCutoff =
                DepthCutoffBase * max(min(CenterDepth, NeighborDepth[Neighbor]), 1.0);
            const bool SurfaceIsContinuous = abs(NeighborDepth[Neighbor] - CenterDepth) <= ContinuityCutoff;

            NeighborContrast[Neighbor] =
                SurfaceIsContinuous ? 1.0 - dot(CenterNormal, NeighborNormal[Neighbor]) : 0.0;
        }

        const float NormalDifference = max(
            abs(NeighborContrast[0] - NeighborContrast[3]),
            abs(NeighborContrast[1] - NeighborContrast[2]));
        const float CreaseWeight = smoothstep(NormalSmoothLow, max(NormalSmoothHigh, NormalSmoothLow + 1e-4),
            NormalDifference);

        if (IsSilhouette)
        {
            EdgeKind = 1;
        }
        else if (CreaseWeight > 0.5)
        {
            // A crease is deliberately TWO texels, one highlighted and one darkened: that light/dark pair
            // reads as a lit bevel. The defect it must not become is two texels given the SAME treatment,
            // which reads as one fat line. Silhouettes stay one-sided via the depth test above.
            //
            // Convex or concave is purely geometric: whichever side faces the viewer more is outward and
            // gets the highlight. No light direction is read, or the outline would move with the sun.
            int MostDifferent = 0;
            float LargestContrast = 0.0;

            [unroll]
            for (int Crease = 0; Crease < 4; ++Crease)
            {
                if (NeighborContrast[Crease] > LargestContrast)
                {
                    LargestContrast = NeighborContrast[Crease];
                    MostDifferent = Crease;
                }
            }

            EdgeKind = dot(CenterNormal, ViewDir) > dot(NeighborNormal[MostDifferent], ViewDir) ? 2 : 1;
        }
    }

    // ---- 2. Bands ---------------------------------------------------------------------------------
    // The banding axis: Rec.601 luminance, or OKLab lightness, which spaces the ladder by PERCEIVED
    // brightness so the darks get their fair share of the bands instead of crowding into the bottom one.
    // Either way the axis is Reinhard-compressed first — this look sits pre-tonemap where the input is
    // unbounded, and a clamp would collapse everything above 1 into the top band.
    const bool UsesOKLab = (int)(ColorSpace + 0.5) == 1;

    float3 LabColor = float3(0.0, 0.0, 0.0);
    float RawAxis;

    if (UsesOKLab)
    {
        LabColor = CkUsf_ToOKLab(max(Color, 0.0));
        RawAxis = max(LabColor.x, 0.0);
    }
    else
    {
        RawAxis = CkUsf_Stylize_Luminance(max(Color, 0.0));
    }

    const float Luminance = RawAxis / (1.0 + RawAxis);

    const float BandCount = max(Bands, 2.0);
    const float BandWidth = 1.0 / BandCount;

    // Dither BEFORE quantizing, and by at most one band: a threshold applied afterwards is a noise
    // overlay on top of banding rather than a way of hiding the boundary.
    const float DitherThreshold = CkUsf_Bayer4x4(In.UV * View.ViewSizeAndInvSize.xy);
    const float DitheredLuminance = saturate(Luminance + (DitherThreshold - 0.5) * BandWidth * saturate(DitherStrength));

    float BandedLuminance = CkUsf_PixelArt_QuantizeBands(DitheredLuminance, BandCount, ThresholdGradientSize);

    // ---- 3. Edge application ----------------------------------------------------------------------
    const bool UsesBandShift = (int)(EdgeMode + 0.5) == 1;
    float FlatEdgeScale = 1.0;

    if (EdgeKind != 0)
    {
        if (UsesBandShift)
        {
            // Exactly one band, so the outline colour is one the palette already contains.
            BandedLuminance = saturate(BandedLuminance + (EdgeKind == 2 ? BandWidth : -BandWidth));
        }
        else
        {
            FlatEdgeScale = EdgeKind == 2 ? (1.0 + max(CreaseBrighten, 0.0))
                                          : saturate(1.0 - saturate(LineDarken));
        }
    }

    // Back out of the normalized domain before re-lighting, or the picture would be uniformly crushed
    // towards black by exactly the amount the normalization compressed it.
    //
    // The clamp is what keeps that inverse finite, and the ceiling is the BAND COUNT rather than a
    // constant: Reinhard's inverse goes to infinity as its input approaches 1, and the top band plus an
    // upward edge shift lands exactly there. Bounded to the top band, the brightest tone this look can
    // emit is BandCount - 1 — so fewer bands is a harder highlight clamp, which falls out of the artist's
    // own choice instead of a magic number.
    const float TopBand = (BandCount - 1.0) / BandCount;
    const float ClampedBand = min(BandedLuminance, TopBand);
    const float BandedTone = ClampedBand / max(1.0 - ClampedBand, 1e-4);

    // Re-light the original hue by the banded tone rather than replacing the colour with a grey ladder:
    // banding the lightness alone is what keeps material colour while quantizing shading. In OKLab that
    // means SETTING L (a/b carry the hue); in luminance space it means rescaling the RGB by the ratio.
    //
    // WarmShift is the reference ramp on OKLab b: bright bands drift warm, dark bands cool, anchored on
    // the band's position so the tint quantizes with the shading instead of smearing across it.
    if (UsesOKLab)
    {
        LabColor.x = BandedTone;
        LabColor.z += (ClampedBand - 0.5) * WarmShift;

        Color = max(CkUsf_FromOKLab(LabColor) * FlatEdgeScale, 0.0);
    }
    else
    {
        Color = max(Color * (BandedTone / max(RawAxis, 1e-4)) * FlatEdgeScale, 0.0);

        if (abs(WarmShift) > 1e-5)
        {
            float3 Warmed = CkUsf_ToOKLab(Color);
            Warmed.z += (ClampedBand - 0.5) * WarmShift;
            Color = CkUsf_FromOKLab(Warmed);
        }
    }

    // ---- 4. Palette -------------------------------------------------------------------------------
    // Compared exactly rather than thresholded, so a mode appended to the enum cannot silently fall into
    // an earlier branch.
    const int Mode = (int)(PaletteMode + 0.5);

    // Bounded from here on, and that is a property of the stage rather than a compromise: once a pixel is
    // snapped to an authored palette, the palette IS the answer and there is no high dynamic range left to
    // preserve. A value above 1 resolves to the brightest entry, which is what the artist chose for
    // "brightest". Everything downstream still tonemaps this like any other scene colour.
    Color = saturate(Color);

    if (Mode == 1)
    {
        float3 Palette[8];
        Palette[0] = PaletteColor0; Palette[1] = PaletteColor1;
        Palette[2] = PaletteColor2; Palette[3] = PaletteColor3;
        Palette[4] = PaletteColor4; Palette[5] = PaletteColor5;
        Palette[6] = PaletteColor6; Palette[7] = PaletteColor7;

        const int LivePaletteCount = clamp((int)(PaletteCount + 0.5), 1, 8);

        Color = UsesOKLab
            ? CkUsf_Stylize_NearestPaletteColorOKLab(Color, Palette, LivePaletteCount)
            : CkUsf_Stylize_NearestPaletteColor(Color, Palette, LivePaletteCount);
    }
    else if (Mode == 2)
    {
        Color = saturate(CkUsf_Stylize_QuantizeLuminance(Color, PaletteCount));
    }
    else
    {
        Color = CkUsf_Stylize_QuantizeSteps(Color, PaletteCount);
    }

    O.EmissiveColor = saturate(Color);
    O.BaseColor = float3(0.0, 0.0, 0.0);
    O.Opacity = 1.0;

    return O;
}
