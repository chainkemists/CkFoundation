// /CkUsf/Looks/Blit.ush
// Trivial display look: samples iChannel0 (a render target) straight to emissive.
// Used to show a multi-pass renderer's output RT on a mesh.
#pragma once
#include "/CkUsf/Common.ush"

FCkUsf_SurfaceOutput CkUsf_Blit(FCkUsf_SurfaceInput In, Texture2D iChannel0, SamplerState iChannel0Sampler)
{
    float Time = In.Time;
    float2 UV = In.UV;
    FCkUsf_SurfaceOutput O = CkUsf_DefaultSurface();
    O.EmissiveColor = iChannel0.SampleLevel(iChannel0Sampler, UV, 0).rgb;
    O.BaseColor = float3(0.0, 0.0, 0.0);
    O.Opacity = 1.0;
    return O;
}
