// /CkUsf/Common.ush — shared CkUsf shader helpers.
#pragma once

struct FCkUsf_SurfaceOutput
{
    float3 BaseColor;
    float  Metallic;
    float  Roughness;
    float3 EmissiveColor;
    float3 Normal;   // tangent space
    float  Opacity;
};

FCkUsf_SurfaceOutput CkUsf_DefaultSurface()
{
    FCkUsf_SurfaceOutput O;
    O.BaseColor = float3(0.5, 0.5, 0.5);
    O.Metallic = 0.0;
    O.Roughness = 0.5;
    O.EmissiveColor = float3(0.0, 0.0, 0.0);
    O.Normal = float3(0.0, 0.0, 1.0);
    O.Opacity = 1.0;
    return O;
}
