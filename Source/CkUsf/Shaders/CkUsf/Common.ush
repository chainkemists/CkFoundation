// /CkUsf/Common.ush — shared CkUsf shader helpers.
#pragma once

// --------------------------------------------------------------------------------------------------------------------
// Per-pixel inputs a look receives. The generator populates the fields that are valid for the look's domain:
//   - Surface looks get Time/UV(mesh TexCoord0)/WorldPosition/CameraVector/VertexNormal/PixelDepth/VertexColor.
//   - PostProcess looks get Time/UV(ScreenPosition) + SceneColor/SceneDepth/SceneNormal (the others stay defaulted).
// Fields not wired for a given domain keep the defaults below, so a look that reads one is safe (just gets a constant).
// --------------------------------------------------------------------------------------------------------------------
struct FCkUsf_SurfaceInput
{
    float  Time;
    float2 UV;             // mesh TexCoord0 (surface) or screen UV (post-process)
    float3 WorldPosition;  // world-space pixel position (surface)
    float3 CameraVector;   // world-space unit vector from pixel toward camera (surface)
    float3 VertexNormal;   // world-space interpolated normal (surface)
    float  PixelDepth;     // distance from camera to this pixel (surface)
    float3 VertexColor;    // interpolated vertex color RGB / per-instance via material (surface)
    float4 SceneColor;     // post-process input 0 (post-process)
    float4 SceneDepth;     // scene depth (post-process)
    float4 SceneNormal;    // world-space scene normal (post-process)
};

FCkUsf_SurfaceInput CkUsf_DefaultInput()
{
    FCkUsf_SurfaceInput I;
    I.Time = 0.0;
    I.UV = float2(0.0, 0.0);
    I.WorldPosition = float3(0.0, 0.0, 0.0);
    I.CameraVector = float3(0.0, 0.0, 1.0);
    I.VertexNormal = float3(0.0, 0.0, 1.0);
    I.PixelDepth = 0.0;
    I.VertexColor = float3(1.0, 1.0, 1.0);
    I.SceneColor = float4(0.0, 0.0, 0.0, 1.0);
    I.SceneDepth = float4(0.0, 0.0, 0.0, 0.0);
    I.SceneNormal = float4(0.0, 0.0, 1.0, 0.0);
    return I;
}

// --------------------------------------------------------------------------------------------------------------------
// Per-vertex inputs a WorldPositionOffset look receives. WPO is a VERTEX-shader output, so this carries
// only VS-safe inputs (no PixelDepth, no Scene* — those are pixel-only and would force a VS compile of
// pixel code). A look opts in by authoring a second entry point:
//   float3 CkUsf_Look_<Name>_WPO(FCkUsf_VertexInput In, <same params as the pixel fn>)
// returning a world-space offset. The generator wires this into a separate VS Custom node (MP_WorldPositionOffset).
// --------------------------------------------------------------------------------------------------------------------
struct FCkUsf_VertexInput
{
    float  Time;
    float2 UV;             // mesh TexCoord0
    float3 WorldPosition;  // world-space vertex position
    float3 VertexNormal;   // world-space vertex normal
    float3 VertexColor;    // interpolated vertex color RGB / per-instance via material
};

FCkUsf_VertexInput CkUsf_DefaultVertexInput()
{
    FCkUsf_VertexInput I;
    I.Time = 0.0;
    I.UV = float2(0.0, 0.0);
    I.WorldPosition = float3(0.0, 0.0, 0.0);
    I.VertexNormal = float3(0.0, 0.0, 1.0);
    I.VertexColor = float3(1.0, 1.0, 1.0);
    return I;
}

// --------------------------------------------------------------------------------------------------------------------
// Per-pixel outputs a look writes. The generator wires each to the matching material pin: lit pins (Metallic/Specular/
// Roughness/AmbientOcclusion) are ignored by unlit looks; Opacity is wired only for translucent-family blends and
// OpacityMask only for the Masked blend. WorldPositionOffset arrives with a later (vertex) bundle.
// --------------------------------------------------------------------------------------------------------------------
struct FCkUsf_SurfaceOutput
{
    float3 BaseColor;
    float  Metallic;
    float  Specular;
    float  Roughness;
    float  AmbientOcclusion;
    float3 EmissiveColor;
    float3 Normal;            // tangent space
    float  Opacity;           // translucent-family blends
    float  OpacityMask;       // Masked blend clip (kept where >= the material's mask clip value)
    float  Refraction;        // IOR scalar; wired only for translucent-family blends (1.0 = no bend / air)
    float3 SubsurfaceColor;   // wired only for the Subsurface shading model
    float  ClearCoat;         // wired only for the ClearCoat shading model (MP_CustomData0)
    float  ClearCoatRoughness;// wired only for the ClearCoat shading model (MP_CustomData1)
};

FCkUsf_SurfaceOutput CkUsf_DefaultSurface()
{
    FCkUsf_SurfaceOutput O;
    O.BaseColor = float3(0.5, 0.5, 0.5);
    O.Metallic = 0.0;
    O.Specular = 0.5;
    O.Roughness = 0.5;
    O.AmbientOcclusion = 1.0;
    O.EmissiveColor = float3(0.0, 0.0, 0.0);
    O.Normal = float3(0.0, 0.0, 1.0);
    O.Opacity = 1.0;
    O.OpacityMask = 1.0;
    O.Refraction = 1.0;
    O.SubsurfaceColor = float3(0.5, 0.2, 0.1);
    O.ClearCoat = 1.0;
    O.ClearCoatRoughness = 0.1;
    return O;
}

// --------------------------------------------------------------------------------------------------------------------
// Hash / noise / fbm helpers shared by the procedural looks.
// --------------------------------------------------------------------------------------------------------------------

float CkUsf_Hash21(float2 P)
{
    float3 P3 = frac(float3(P.xyx) * 0.1031);
    P3 += dot(P3, P3.yzx + 33.33);
    return frac((P3.x + P3.y) * P3.z);
}

float2 CkUsf_Hash22(float2 P)
{
    float3 P3 = frac(float3(P.xyx) * float3(0.1031, 0.1030, 0.0973));
    P3 += dot(P3, P3.yzx + 33.33);
    return frac((P3.xx + P3.yz) * P3.zy);
}

float CkUsf_ValueNoise(float2 P)
{
    float2 I = floor(P);
    float2 F = frac(P);
    float2 U = F * F * (3.0 - 2.0 * F);
    float A = CkUsf_Hash21(I + float2(0.0, 0.0));
    float B = CkUsf_Hash21(I + float2(1.0, 0.0));
    float C = CkUsf_Hash21(I + float2(0.0, 1.0));
    float D = CkUsf_Hash21(I + float2(1.0, 1.0));
    return lerp(lerp(A, B, U.x), lerp(C, D, U.x), U.y);
}

float CkUsf_Fbm(float2 P)
{
    float V = 0.0;
    float Amp = 0.5;
    for (int I = 0; I < 5; ++I)
    {
        V += Amp * CkUsf_ValueNoise(P);
        P *= 2.0;
        Amp *= 0.5;
    }
    return V;
}

// Cosine palette (Inigo Quilez): cheap, vivid color ramps from a scalar T.
float3 CkUsf_Palette(float T, float3 A, float3 B, float3 C, float3 D)
{
    return A + B * cos(6.28318 * (C * T + D));
}
