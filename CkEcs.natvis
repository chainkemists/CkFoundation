<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="FCk_Entity">
    <DisplayString>{{{_EntityNumber}|{_EntityVersion} ({_ID})}}</DisplayString>
  </Type>

  <Type Name="TCk_DebugWrapper&lt;*&gt;">
    <DisplayString>{"$T1"}</DisplayString>
    <Expand>
      <Item Name="[Fragment]">
        ($T1&amp;)(*_Fragment)
      </Item>
    </Expand>
  </Type>

  <Type Name="TCk_DebugWrapper&lt;DEBUG_NAME&gt;">
    <DisplayString>{{ {_Fragment->_Name} }}</DisplayString>
  </Type>

  <Type Name="DEBUG_NAME">
    <DisplayString>{{ {_Name} }}</DisplayString>
  </Type>

  <Type Name="NAME_ConstructionScript">
    <DisplayString>{{ {_Name} }}</DisplayString>
  </Type>

  <Type Name="FCk_Handle" Inheritable="true">
    <DisplayString Condition="_Entity._ID == {,,UnrealEditor-CkEcs-Win64-DebugGame.dll}FCk_Entity::_Tombstone._ID" Optional="true">Tombstone - INVALID {_Entity}</DisplayString>
    <DisplayString Condition="_Entity._ID == {,,UnrealEditor-CkEcs-Win64.dll}FCk_Entity::_Tombstone._ID" Optional="true">Tombstone - INVALID {_Entity}</DisplayString>
    <DisplayString Condition="!_Registry.Value.bIsSet">{{INVALID Registry {_Entity}}}</DisplayString>
    <DisplayString Condition="_Mapper->_IsHost &amp;&amp; _Mapper->_IsClient">{{ID{_Entity}[Client AND Host][{_Mapper->_LifetimeTagName}][{*_Mapper->_DebugName}] Tags[{_Mapper->_AllTags.ArrayNum}] Fragments[{_Mapper->_AllFragments.ArrayNum}]}}</DisplayString>
    <DisplayString Condition="_Mapper->_IsHost">{{ID{_Entity}[Host][{_Mapper->_LifetimeTagName}][{*_Mapper->_DebugName}] Tags[{_Mapper->_AllTags.ArrayNum}] Fragments[{_Mapper->_AllFragments.ArrayNum}]}}</DisplayString>
    <DisplayString Condition="!_Mapper->_IsHost">{{ID{_Entity}[Client][{_Mapper->_LifetimeTagName}][{*_Mapper->_DebugName}] Tags[{_Mapper->_AllTags.ArrayNum}] Fragments[{_Mapper->_AllFragments.ArrayNum}]}}</DisplayString>
    <Expand>
      <Item Name="[Host]">
      (_Mapper->_IsHost)
      </Item>
      <Item Name="[Client]">
      (_Mapper->_IsClient)
      </Item>
      <Item Name="[Name]">
      (*_Mapper->_DebugNameFragment)
      </Item>
      <Item Name="[CTX]">
      (*_Mapper->_Context)
      </Item>
      <Item Name="[Lifetime]">
      (*_Mapper->_LifetimeTag)
      </Item>
      <Item Name="[Tags]">
      (_Mapper->_AllTags)
      </Item>
      <Item Name="[Fragments]">
      (_Mapper->_AllFragments)
      </Item>
    </Expand>
  </Type>

  <Type Name="FCk_Handle_TypeSafe" Inheritable="true">
    <DisplayString>{(*(FCk_Handle*)(this))}</DisplayString>
    <Expand>
      <!--This is a workaround for the FCk_Handle natvis not working for all inheritable types even though it should. Why *? Because it takes the least amount of characters-->
      <Item Name="*">
      (*(FCk_Handle*)(this))
      </Item>
    </Expand>
  </Type>

  <Type Name="FEntity_FragmentMapper">
    <DisplayString>{{Name{_DebugName}}}</DisplayString>
    <Expand>
      <Item Name="[Name]">
      (_DebugNameFragment)
      </Item>
      <Item Name="[Lifetime]">
      (_LifetimeTag)
      </Item>
      <Item Name="[Tags]">
      (_AllTags)
      </Item>
      <Item Name="[Fragments]">
      (_AllFragments)
      </Item>
    </Expand>
  </Type>

  <!-- FCk_Time -->

  <Type Name="FCk_Time">
    <DisplayString>{_Seconds,g}s</DisplayString>
  </Type>

  <!-- Shape dimension data structs -->

  <Type Name="FCk_ShapeSphere_Dimensions">
    <DisplayString>r={_Radius,g}</DisplayString>
  </Type>

  <Type Name="FCk_ShapeBox_Dimensions">
    <DisplayString>{_HalfExtents} convR={_ConvexRadius,g}</DisplayString>
    <Expand>
      <Item Name="[HalfExtents]">_HalfExtents</Item>
      <Item Name="[ConvexRadius]">_ConvexRadius</Item>
    </Expand>
  </Type>

  <Type Name="FCk_ShapeCapsule_Dimensions">
    <DisplayString>h={_HalfHeight,g} r={_Radius,g}</DisplayString>
  </Type>

  <Type Name="FCk_ShapeCylinder_Dimensions">
    <DisplayString>h={_HalfHeight,g} r={_Radius,g} convR={_ConvexRadius,g}</DisplayString>
  </Type>

  <!-- Shape Current fragments -->

  <Type Name="ck::FFragment_ShapeSphere_Current">
    <DisplayString>{_Dimensions}</DisplayString>
    <Expand>
      <ExpandedItem>_Dimensions</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="ck::FFragment_ShapeBox_Current">
    <DisplayString>{_Dimensions}</DisplayString>
    <Expand>
      <ExpandedItem>_Dimensions</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="ck::FFragment_ShapeCapsule_Current">
    <DisplayString>{_Dimensions}</DisplayString>
    <Expand>
      <ExpandedItem>_Dimensions</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="ck::FFragment_ShapeCylinder_Current">
    <DisplayString>{_Dimensions}</DisplayString>
    <Expand>
      <ExpandedItem>_Dimensions</ExpandedItem>
    </Expand>
  </Type>

  <!-- Physics Current fragments -->

  <Type Name="ck::FFragment_Velocity_Current">
    <DisplayString>vel={_CurrentVelocity}</DisplayString>
  </Type>

  <Type Name="ck::FFragment_Acceleration_Current">
    <DisplayString>acc={_CurrentAcceleration}</DisplayString>
  </Type>

  <Type Name="ck::FFragment_EulerIntegrator_Current">
    <DisplayString>offset={_DistanceOffset}</DisplayString>
  </Type>

  <Type Name="ck::FFragment_PredictedVelocity_Current">
    <DisplayString>vel={_CurrentVelocity} dt={_PreviousDeltaTime}</DisplayString>
    <Expand>
      <Item Name="[Velocity]">_CurrentVelocity</Item>
      <Item Name="[Prev Location]">_PreviousLocation</Item>
      <Item Name="[Prev DeltaTime]">_PreviousDeltaTime</Item>
    </Expand>
  </Type>

  <!-- Tween -->

  <Type Name="ECk_TweenState">
    <DisplayString Condition="*this == 0">Playing</DisplayString>
    <DisplayString Condition="*this == 1">Paused</DisplayString>
    <DisplayString Condition="*this == 2">Completed</DisplayString>
    <DisplayString Condition="*this == 3">Cancelled</DisplayString>
    <DisplayString>Unknown({(int)*this})</DisplayString>
  </Type>

  <Type Name="ck::FFragment_Tween_Current">
    <DisplayString>{_State} t={_CurrentTime,g} loop={_CurrentLoop}</DisplayString>
    <Expand>
      <Item Name="[State]">_State</Item>
      <Item Name="[Time]">_CurrentTime</Item>
      <Item Name="[Loop]">_CurrentLoop</Item>
      <Item Name="[Reversed]">_IsReversed</Item>
      <Item Name="[TimeMultiplier]">_TimeMultiplier</Item>
    </Expand>
  </Type>

  <!-- AStar -->

  <Type Name="ECk_AStarSearchStatus">
    <DisplayString Condition="*this == 0">Idle</DisplayString>
    <DisplayString Condition="*this == 1">InProgress</DisplayString>
    <DisplayString Condition="*this == 2">Complete</DisplayString>
    <DisplayString Condition="*this == 3">Failed</DisplayString>
    <DisplayString Condition="*this == 4">CostThresholdReached</DisplayString>
    <DisplayString>Unknown({(int)*this})</DisplayString>
  </Type>

  <Type Name="ck::FFragment_AStar_Debug">
    <DisplayString>{_SearchStatus} iter={_IterationsThisFrame} {_BudgetUsagePercent,g}%</DisplayString>
    <Expand>
      <Item Name="[Status]">_SearchStatus</Item>
      <Item Name="[Open Set]">_OpenSetSize</Item>
      <Item Name="[Closed Set]">_ClosedSetSize</Item>
      <Item Name="[Iterations]">_IterationsThisFrame</Item>
      <Item Name="[Time (us)]">_TimeThisFrameMicroseconds</Item>
      <Item Name="[Budget %]">_BudgetUsagePercent</Item>
    </Expand>
  </Type>

  <!-- State Machine -->

  <Type Name="ECk_SmRunStatus">
    <DisplayString Condition="*this == 0">Stopped</DisplayString>
    <DisplayString Condition="*this == 1">Running</DisplayString>
    <DisplayString Condition="*this == 2">Paused</DisplayString>
    <DisplayString>Unknown({(int)*this})</DisplayString>
  </Type>

  <!-- State Tree -->

  <Type Name="ECk_StateTree_RunStatus">
    <DisplayString Condition="*this == 0">Stopped</DisplayString>
    <DisplayString Condition="*this == 1">Running</DisplayString>
    <DisplayString Condition="*this == 2">Paused</DisplayString>
    <DisplayString>Unknown({(int)*this})</DisplayString>
  </Type>

  <Type Name="ck::FFragment_StateTree_Current">
    <DisplayString>{_RunStatus}</DisplayString>
    <Expand>
      <Item Name="[Status]">_RunStatus</Item>
      <Item Name="[Owner]">_Owner</Item>
    </Expand>
  </Type>

  <!-- Montage Player -->

  <Type Name="ECk_MontagePlayer_StateKind">
    <DisplayString Condition="*this == 0">Play</DisplayString>
    <DisplayString Condition="*this == 1">Stop</DisplayString>
    <DisplayString Condition="*this == 2">Pause</DisplayString>
    <DisplayString Condition="*this == 3">Resume</DisplayString>
    <DisplayString Condition="*this == 4">JumpToSection</DisplayString>
    <DisplayString>Unknown({(int)*this})</DisplayString>
  </Type>

  <Type Name="FCk_MontagePlayer_State">
    <DisplayString>{_Kind}</DisplayString>
    <Expand>
      <Item Name="[Kind]">_Kind</Item>
      <Item Name="[Montage]">_Montage</Item>
      <Item Name="[Section]">_SectionName</Item>
      <Item Name="[PlayRate]">_PlayRate</Item>
    </Expand>
  </Type>

  <Type Name="ck::FFragment_MontagePlayer_Current">
    <DisplayString>{_State._Kind}</DisplayString>
    <Expand>
      <Item Name="[State]">_State</Item>
      <Item Name="[Active Montage]">_ActiveMontage</Item>
      <Item Name="[Anim Instance]">_LastSeenAnimInstance</Item>
      <Item Name="[Catch-up]">_CatchUpRemaining</Item>
    </Expand>
  </Type>

  <!-- Debug Callstack Visualizers -->

  <!-- Visualizer for pointer array that auto-dereferences -->
  <Type Name="TArray&lt;const FString *,*&gt;">
    <DisplayString>{{Num={ArrayNum}}}</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="i" InitialValue="0" />
        <Variable Name="count" InitialValue="ArrayNum" />
        <Size>count</Size>
        <Loop>
          <Break Condition="i >= count" />
          <Item Name="[{i}]">*AllocatorInstance.Data[i]</Item>
          <Exec>i++</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="ck::TFragment_Debug_Callstack&lt;*&gt;">
    <DisplayString>{{Entries: {_Entries.ArrayNum}}}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>_Entries.ArrayNum</Size>
        <ValuePointer>_Entries.AllocatorInstance.Data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="ck::TFragment_Debug_Callstack&lt;*&gt;::FCallEntry">
    <DisplayString Condition="Message.Data.ArrayNum &gt; 0">{{F#{FrameNumber} {FunctionName,sb}:{LineNumber} "{Message.Data,su}"}}</DisplayString>
    <DisplayString Condition="Message.Data.ArrayNum == 0">{{F#{FrameNumber} {FunctionName,sb}:{LineNumber}}}</DisplayString>
    <Expand>
      <Item Name="[Frame]">FrameNumber</Item>
      <Item Name="[Function]">FunctionName,sb</Item>
      <Item Name="[Line]">LineNumber</Item>
      <Item Name="[Message]" Condition="Message.Data.ArrayNum &gt; 0">Message</Item>

      <!-- C++ Callstack - automatically dereferences pointers to show symbols -->
      <ExpandedItem Condition="CppCallstackAddresses.ArrayNum &gt; 0">CppCallstackAddresses</ExpandedItem>

      <Item Name="[Blueprint Callstack]" Condition="BlueprintCallstack.ArrayNum &gt; 0">BlueprintCallstack</Item>
      <Item Name="[Angelscript Callstack]" Condition="AngelscriptCallstack.ArrayNum &gt; 0">AngelscriptCallstack</Item>
    </Expand>
  </Type>
</AutoVisualizer>
