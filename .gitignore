# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# misc
sync.ffs_db
.git-credentials

# md files, they should be force added instead
*.md

# ...except the Claude skill library / reports / project template, which are tracked
!.claude/**/*.md

# ...and the CkParticles VFX cookbook — recipes are a source-controlled deliverable, and adding a new
# one must not depend on remembering to force-add it
!Source/CkParticles/Cookbook/**/*.md

# ...and campaign doc sets — PROGRESS.md moves every session and new PHASE_N.md files appear at
# phase boundaries; neither may silently fall out of tracking
!docs/**/*.md

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*
Script/Generated/

# CkAngelscriptGenerator self-heal stub recovery files (explicit — the whole
# Script/Generated/ tree is already ignored above, but listing these
# patterns documents the convention and keeps parity with the BB root
# .gitignore).
Script/Generated/_StubRecovery_*.as
Script/Generated/_StubRecovery_*.json

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# idea files
*.idea/*
Source/CkScripts/.idea

# Auto-generated build-id header (written by CkCore.Build.cs)
Source/CkCore/Public/CkCore/Generated/CkCore_BuildId.h
*.orig
Source/CkWatermark/Public/CkWatermark/Generated/CkWatermark_BuildId.h
